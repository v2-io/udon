; Prose and text — block prose, sameline text, and the \ escape
;
; CORE spec areas: "Prose Content", "Escape (\)" (head-position force-
; prose and the in-prose inline-opener escapes), "Sameline Comments" (the
; framed ' ; ' carve-out), and "Automatic Prose Dedentation" (the prose
; side; the element loop owns content_base bookkeeping).


; bs_escape - the shared in-prose `\` escape lookahead (CORE "Escape"):
; the caller consumed the `\` (leaving it in the accumulation span) and
; calls here from its text-collecting state. If the `\` completes an
; inline-opener escape (`\|{` `\!{` `\;{`), the pending Text is emitted
; WITHOUT the `\`+marker (TERM(-2)), and the opener is made literal: the
; marker is PREPENDed and the `{` left current for the caller to
; accumulate as plain text. Anything else — including EOF parked anywhere
; in the lookahead — consumes nothing further and keeps every byte (`\`,
; and marker if consumed) in the caller's accumulation: a `\` that does
; not complete an opener is literal, and the caller's own eof/eol arm
; emits it (CORE "End of input (EOF)": nothing is ever discarded).
|function[bs_escape]
  |state[:main]
    |eof                      |                                  |return
    |c['|']                   | ->                               |>> :pipe
    |c['!']                   | ->                               |>> :bang
    |c[';']                   | ->                               |>> :semi
    |default                  |                                  |return

  |state[:pipe]
    |eof                      |                                  |return
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('|') |return
    |default                  |                                  |return
  |state[:bang]
    |eof                      |                                  |return
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('!') |return
    |default                  |                                  |return
  |state[:semi]
    |eof                      |                                  |return
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND(';') |return
    |default                  |                                  |return


; verbatim_text - head-position `\` escape (CORE "Escape (\)", ratified
; posture): the backslash was consumed by the caller; the rest of the
; physical line is PROSE-SHAPED — dead to line-level structure and to the
; sameline-comment frame (a framed ' ; ' is literal), but alive to inline
; forms (|{...} !{...} ;{...}), each individually escapable. The consumed
; `\` takes no column. Trailing newline is left for the caller's line loop.
|function[verbatim_text]  | MARK
  |state[:main]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c['|']                   | ->                               |>> :vpipe
    |c['!']                   | ->                               |>> :vbang
    |c[';']                   | ->                               |>> :vsemi
    |c[<BS>]                  | -> | /bs_escape                  |>> :main
    |default                  | ->                               |>>

  |state[:vpipe]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include | in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /embedded |>> :vafter
    |default                  |                                  |>> :main
  |state[:vbang]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ! in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /sameline_directive |>> :vafter
    |default                  |                                  |>> :main
  |state[:vsemi]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ; in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /brace_comment |>> :vafter
    |default                  |                                  |>> :main

  |state[:vafter]
    |eof                      |                                  |return
    |c['\n']                  |                                  |return
    |default                  | MARK                             |>> :main


; prose - block-level text content with optional prepend character
; :prepend = <> (none), '|' (pipe prefix), '`' (backtick prefix)
|function[prose]  :line_col :parent_col :prepend
  |if[:parent_col >= 0 && :line_col <= :parent_col]          |return  ; dedent

  |state[:content]
    | /text(:line_col, :parent_col, :prepend)                    |return


; prose_backticks - two backticks (not freeform, just text starting with ``)
|function[prose_backticks]  :line_col :parent_col
  |if[:parent_col >= 0 && :line_col <= :parent_col]          |return

  |state[:content]
    | /text_backticks(:line_col, :parent_col)                    |return


; text_backticks - text that starts with `` (for non-freeform case)
; Manual emit control, no :Text auto-emit
; Semicolons in prose are LITERAL - only `;{...}` triggers inline comment
|function[text_backticks]  :line_col :parent_col
  |state[:entry]
    | MARK | PREPEND('`') | PREPEND('`')                         |>> :main

  |state[:main]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c['|']                   | ->                               |>> :check_pipe
    |c[';']                   | ->                               |>> :check_semi
    |c['!']                   | ->                               |>> :check_bang
    |c[<BS>]                  | -> | /bs_escape                  |>> :main
    |default                  | ->                               |>>

  |state[:check_pipe]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include | in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /embedded |>> :after_inline
    |default                  |                                  |>> :main

  ; Semicolons in prose are LITERAL - only `;{...}` triggers inline comment
  |state[:check_semi]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ; in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /brace_comment |>> :after_inline
    |default                  |                                  |>> :main  ; semicolon is literal

  |state[:check_bang]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ! in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /sameline_directive |>> :after_inline
    |default                  |                                  |>> :main


  ; After inline construct - only set MARK if more content follows
  |state[:after_inline]
    |c['\n']                  |                                  |return  ; at end, no emit
    |eof                      |                                  |return  ; at end, no emit
    |default                  | MARK                             |>> :main


; text - block-level prose content (manual emit control, no :Text auto-emit)
; Same pattern as sameline_text: advance past special chars, check what follows.
; :prepend = <> (none), '|' (pipe prefix), '`' (backtick prefix)
; Semicolons in prose are LITERAL - only `;{...}` triggers inline comment
; (`;` at line start is handled by document/element children loop, not here)
|function[text]  :line_col :parent_col :prepend
  |state[:entry]
    | MARK | PREPEND(:prepend)                                   |>> :main

  |state[:main]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c['|']                   | ->                               |>> :check_pipe
    |c[';']                   | ->                               |>> :check_semi
    |c['!']                   | ->                               |>> :check_bang
    |c[<BS>]                  | -> | /bs_escape                  |>> :main
    |default                  | ->                               |>>

  |state[:check_pipe]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include | in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /embedded |>> :after_inline
    |default                  |                                  |>> :main

  ; Semicolons in prose are LITERAL - only `;{...}` triggers inline comment
  |state[:check_semi]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ; in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /brace_comment |>> :after_inline
    |default                  |                                  |>> :main  ; semicolon is literal

  |state[:check_bang]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ! in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /sameline_directive |>> :after_inline
    |default                  |                                  |>> :main


  ; After inline construct - only set MARK if more content follows
  |state[:after_inline]
    |c['\n']                  |                                  |return  ; at end, no emit
    |eof                      |                                  |return  ; at end, no emit
    |default                  | MARK                             |>> :main


; sameline_text - text on same line as element (manual emit control, no :Text auto-emit)
; When special chars (|;!) are encountered, we advance past them, then check
; what follows. If special construct, emit text before it and parse construct.
; If not special, just continue (char is included in text).
; :prepend = <> (none), '|' (pipe prefix), '!' (bang prefix)
|function[sameline_text]  :elem_col :prepend
  |state[:entry]
    | MARK | PREPEND(:prepend)                                   |>> :main

  |state[:main]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c['|']                   | ->                               |>> :check_pipe
    |c[';']                   |                                  |>> :check_semi
    |c['!']                   | ->                               |>> :check_bang
    |c[<BS>]                  | -> | /bs_escape                  |>> :main
    |default                  | ->                               |>>

  |state[:check_pipe]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include | in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /embedded |>> :after_inline
    |c[<XLBL_START SQ '[' '.?!*+'>] |                               |>> :check_pipe_elem_col
    |default                  |                                  |>> :main

  ; Check if inline element's column requires closing current element first
  |state[:check_pipe_elem_col]
    |if[COL - 1 <= :elem_col] | TERM(-1) | Text(USE_MARK)         |return
    |                        | TERM(-1) | Text(USE_MARK) | /element(COL - 1, :elem_col) |>> :after_inline

  ; Sameline comment (CORE "Sameline Comments", ratified 2026-07-15): a `;`
  ; opens a comment after prose ONLY when whitespace-framed — space before,
  ; space or end-of-line after. `;{` (inline comment) needs no frame.
  ; Routed here WITHOUT consuming, so PREV is the char before the `;`.
  |state[:check_semi]
    |if[PREV == ' ']          | ->                               |>> :semi_spaced
    |default                  | ->                               |>> :semi_glued

  |state[:semi_spaced]
    |eof                      | TERM(-1) | Text(USE_MARK) | /line_comment_content |return
    |c['\n']                  | TERM(-1) | Text(USE_MARK) | /line_comment_content |return
    |c[' ']                   | TERM(-1) | Text(USE_MARK) | /line_comment_content |return
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /brace_comment |>> :after_inline
    |default                  |                                  |>> :main  ; ";x" — unframed, literal

  |state[:semi_glued]
    |eof                      | TERM | Text(USE_MARK)            |return  ; literal ;
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /brace_comment |>> :after_inline
    |default                  |                                  |>> :main  ; literal ;

  |state[:check_bang]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ! in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /sameline_directive |>> :after_inline
    |default                  |                                  |>> :main


  ; After inline construct - only set MARK if more content follows
  |state[:after_inline]
    |c['\n']                  |                                  |return  ; at end, no emit
    |eof                      |                                  |return  ; at end, no emit
    |default                  | MARK                             |>> :main
