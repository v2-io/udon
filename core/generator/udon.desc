; UDON Parser - Main Grammar Definition
;
; This file defines the core UDON grammar: elements, attributes, nesting,
; prose, comments, directives, and embedded content.
;
; DEPENDENCIES:
;   This file is concatenated with values.desc before generation.
;   Values.desc provides: /typed_value (emits Integer or Float)
;
; GENERATION:
;   ./regenerate-parser  # concatenates *.desc files and runs descent
;
; Design:
;   1. Type system declares emit behavior
;   2. EOF handling inferred from context
;   3. No explicit emit() calls
;   4. DSL describes grammar, generator infers mechanics
;
; Type categories:
;   BRACKET  - emits Start on entry, End on exit (Element, Embedded, Directive, Array)
;   CONTENT  - emits event on return (Name, Text, Comment, Attr, Value, etc.)
;   INTERNAL - no emit, used for intermediate values (indent count, flags)

|parser udon

; ============================================================================
; Type Declarations
; ============================================================================

|type[Element]       BRACKET    ; ElementStart on entry, ElementEnd on exit
|type[Embedded]      BRACKET    ; EmbeddedStart/End
|type[Directive]     BRACKET    ; DirectiveStart/End
|type[Array]         BRACKET    ; ArrayStart/End
|type[Freeform]      BRACKET    ; FreeformStart/End

|type[Name]          CONTENT    ; emits Name event on return
|type[Text]          CONTENT    ; emits Text event
|type[Comment]       BRACKET    ; CommentStart/End - block structure like Element
|type[Attr]          CONTENT    ; emits Attr event
|type[StringValue]   CONTENT    ; emits StringValue event
|type[BareValue]     CONTENT    ; emits BareValue event
|type[BoolTrue]      CONTENT    ; emits BoolTrue event
|type[BoolFalse]     CONTENT    ; emits BoolFalse event
|type[Nil]           CONTENT    ; emits Nil event
|type[Interpolation] CONTENT    ; emits Interpolation event
|type[Reference]     CONTENT    ; emits Reference event
|type[RawContent]    CONTENT    ; emits RawContent event
|type[Raw]           CONTENT    ; emits Raw flag event
|type[Integer]       CONTENT    ; emits Integer event (from values.desc)
|type[Float]         CONTENT    ; emits Float event (from values.desc)
|type[Rational]      CONTENT    ; emits Rational event (1/3r)
|type[Complex]       CONTENT    ; emits Complex event (3+4i, 5i)
|type[Warning]       CONTENT    ; emits Warning event (parser warnings)
|type[BlankLine]     CONTENT    ; emits BlankLine for blank/whitespace-only lines

|type[INT]           INTERNAL   ; no emit - internal integer
|type[BOOL]          INTERNAL   ; no emit - internal boolean


; ============================================================================
; Entry Point
; ============================================================================

|entry-point /document

|function[document]
  ; :line is a FRESH line start: a bare newline here is a blank line and
  ; emits BlankLine (CORE parser-behavior note). Constructs that stop at
  ; their own terminating newline route through :eol so that newline is
  ; consumed silently first.
  |state[:line]
    |c['\n']                  | -> | BlankLine                   |>>
    |c[' ']                   | col = /count_indent              |>> :dispatch
    |c['\t']                  | /error(NoTabs) | ->['\n'] | ->       |>> :line
    |default                  | col = COL - 1                    |>> :dispatch  ; use actual column

  |state[:eol]
    |eof                      |                                  |return
    |c['\n']                  | ->                               |>> :line
    |default                  | col = COL - 1                    |>> :dispatch  ; construct returned mid-line

  |state[:dispatch]
    |c['|']                   | ->                               |>> :check_pipe
    |c[':']                   | ->                               |>> :check_attr
    |c['!']                   | ->                               |>> :check_bang
    |c[';']                   | -> | /line_comment               |>> :line
    |c['@']                   | ->                               |>> :check_at
    |c['`']                   | ->                               |>> :check_freeform
    |c[<BS>]                  | -> | /verbatim_text              |>> :eol
    |default                  | /prose(col, -1, <>)              |>> :eol

  ; Line-initial attr must be followed by a name start, quoted name, or
  ; reference bracket. Anything else falls back to INTACT prose — the
  ; colon is restored, never eaten (defect #12 data-loss half; the
  ; promotion boundary itself is open decision 9).
  |state[:check_attr]
    |c[<XLBL_START SQ>]       | dstate = /block_attr             |>> :root_attr_check
    |default                  | /prose(col, -1, ':')             |>> :eol

  ; Deferred values are not supported at document root (attrs there are
  ; already an edge case) — an open attr resolves immediately.
  |state[:root_attr_check]
    |if[dstate == 1]          | /error(missing_attribute_value) | Nil |>> :eol
    |default                  |                                  |>> :eol

  ; `!` guard (CORE Marker Recognition): directive only when followed by an
  ; identifier or ':' (raw). `!{` at head position is the PROSE-LEVEL inline
  ; form (interpolation / inline directive), NOT a block-Directive wrapper.
  ; Everything else (![img], !=, bare !) is prose with the '!' restored.
  |state[:check_bang]
    |c[':']                   | /block_directive(col)            |>> :line
    |c[XLBL_START]            | /block_directive(col)            |>> :line
    |c['{']                   | -> | /sameline_directive         |>> :eol
    |default                  | /prose(col, -1, '!')             |>> :eol

  ; `@` guard (CORE Marker Recognition, 0.9): reference when followed by `[`,
  ; `.` (trait-only selector, ruled 2026-07-16), or an identifier; otherwise
  ; prose. The payload is the raw text after `@`.
  |state[:check_at]
    |c[<L XLBL_START '.'>]    | /block_ref                       |>> :eol
    |default                  | /prose(col, -1, '@')             |>> :eol

  |state[:check_freeform]
    |c['`']                   | ->                               |>> :check_freeform2
    |default                  | /prose(col, -1, '`')             |>> :eol

  |state[:check_freeform2]
    |c['`']                   | -> | /freeform                   |>> :line
    |default                  | /prose_backticks(col, -1)        |>> :eol

  |state[:check_pipe]
    |c[<XLBL_START SQ '[' '.?!*+'>]  | /element(col, -1)               |>> :line
    |c['{']                   | -> | /embedded                   |>> :eol
    |default                  | /prose(col, -1, '|')             |>> :eol


; ============================================================================
; Utilities
; ============================================================================

|function[count_indent:INT]  | result = 0
  |state[:main]
    |c[' ']                   | -> | result += 1                 |>>
    |default                  |                                  |return result


; NOTE: Error events are emitted inline where needed, e.g. Error(no_tabs)
; No separate error function needed - the generator handles error codes.


; ============================================================================
; Element Identity Parsing (shared between element and embedded)
; ============================================================================

; DRYed: parse_element_identity(:close) - void helper for element identity
; Parses: name?[id].class (suffix can appear before [id] and .class per SPEC 200-215)
; :close = closer byte (} for embedded, 0 for block element)
; Returns when identity complete or closer hit. Caller handles content.
|function[parse_element_identity]  :close
  |state[:identity]
    |c[:close]                |                                  |return  ; closer hit (empty)
    |c[XLBL_START]            | /name                            |>> :post_name
    |c[<SQ>]                  | ->                               |>> :quoted_name
    |c['[']                   | ->                               |>> :bracket
    |c['.']                   |                                  |>> :class
    |c['?!*+']                | /suffix                          |>> :post_suffix
    |default                  |                                  |return  ; anonymous, identity done

  |state[:quoted_name]
    |c[<SQ>]                  | ->                               |>> :post_name
    |default                  | /quoted_name                     |>> :post_name

  |state[:post_name]
    |c[:close]                |                                  |return
    |c['[']                   | ->                               |>> :bracket
    |c['.']                   |                                  |>> :class
    |c['?!*+']                | /suffix                          |>> :post_suffix
    |default                  |                                  |return

  ; After suffix, can still have [id] and .class (SPEC 204-205: |name?[id].class)
  |state[:post_suffix]
    |c[:close]                |                                  |return
    |c['[']                   | ->                               |>> :bracket
    |c['.']                   |                                  |>> :class
    |default                  |                                  |return

  |state[:bracket]
    |c[']']                   | ->                               |>> :post_bracket
    |default                  | Attr($key) | /value(1, ']')       |>> :bracket_close

  |state[:bracket_close]
    |c[']']                   | ->                               |>> :post_bracket
    |default                  |                                  |return  ; unclosed

  |state[:post_bracket]
    |c[:close]                |                                  |return
    |c['.']                   |                                  |>> :class
    |c['?!*+']                | /suffix                          |>> :post_suffix
    |default                  |                                  |return

  |state[:class]
    |c['.']                   | ->                               |>>
    |c[XLBL_START]            | Attr($traits) | /class_name       |>> :post_class
    |c[<SQ>]                  | Attr($traits) | -> | /quoted_class |>> :post_class
    |default                  |                                  |return  ; no more classes

  |state[:post_class]
    |c[:close]                |                                  |return
    |c['.']                   |                                  |>> :class
    |c['?!*+']                | /suffix                          |>> :post_suffix
    |default                  |                                  |return


; ============================================================================
; Element (block form - indent-based children)
; ============================================================================

|function[element:Element]  :elem_col :parent_col  | content_base = -1 | content_seen = 0 | attr_open = 0 | attr_col = -1

  |state[:identity]
    | /parse_element_identity(<>)                                |>> :post_identity

  |state[:post_identity]
    |c['\n']                  | ->                               |>> :children
    |c[' \t']                 | ->                               |>> :pre_content
    |c[<BS>]                  | -> | content_seen = 1 | /verbatim_text |>> :after_content
    |default                  | content_seen = 1 | /sameline_text(:elem_col, <>) |>> :after_content

  |state[:pre_content]
    |c['\n']                  | ->                               |>> :children
    |c[' \t']                 | ->                               |>>
    |c['`']                   | ->                               |>> :sameline_ff1
    |c['?']                   | ->                               |>> :spaced_suffix_q
    |c['*']                   | ->                               |>> :spaced_suffix_s
    |c['+']                   | ->                               |>> :spaced_suffix_p
    |c[':']                   | ->                               |>> :check_sameline_attr
    |c['|']                   | ->                               |>> :check_sameline_pipe
    |c[';']                   | ->                               |>> :check_sameline_semi
    |c['!']                   | ->                               |>> :check_sameline_bang
    |c['@']                   | ->                               |>> :check_sameline_at
    |c[<BS>]                  | -> | content_seen = 1 | /verbatim_text |>> :after_content
    |default                  | content_seen = 1 | /sameline_text(:elem_col, <>) |>> :after_content

  ; Sameline fence: attributes keep the scan open, so triple-backticks after
  ; elements/attributes open a freeform block (CORE "Triple-Backtick
  ; Escape"). Fewer than three backticks fall back to sameline text.
  |state[:sameline_ff1]
    |c['`']                   | ->                               |>> :sameline_ff2
    |default                  | /sameline_text(:elem_col, '`')   |>> :after_content
  |state[:sameline_ff2]
    |c['`']                   | -> | /freeform                   |>> :after_content
    |default                  | /sameline_text(:elem_col, '``')  |>> :after_content

  ; Space-separated element-level suffix (CORE "Suffix positions":
  ; `|name[key].trait ?`): the suffix char must stand alone — followed by
  ; whitespace or end-of-line. Otherwise it is prose (restored via PREPEND).
  ; Only ? * + take this path; a spaced '!' keeps its dynamics meaning.
  |state[:spaced_suffix_q]
    |eof                      | Attr($?) | BoolTrue              |return
    |c[' \t\n']               | Attr($?) | BoolTrue              |>> :post_identity
    |default                  | PREPEND('?') | /sameline_text(:elem_col, <>) |>> :after_content
  |state[:spaced_suffix_s]
    |eof                      | Attr($*) | BoolTrue              |return
    |c[' \t\n']               | Attr($*) | BoolTrue              |>> :post_identity
    |default                  | PREPEND('*') | /sameline_text(:elem_col, <>) |>> :after_content
  |state[:spaced_suffix_p]
    |eof                      | Attr($+) | BoolTrue              |return
    |c[' \t\n']               | Attr($+) | BoolTrue              |>> :post_identity
    |default                  | PREPEND('+') | /sameline_text(:elem_col, <>) |>> :after_content

  ; Sameline attr guard: a ':' not followed by a name start / quoted name /
  ; reference bracket is not an attr — fall back to intact text with the
  ; ':' restored (defect #12 data-loss half).
  |state[:check_sameline_attr]
    |c[<XLBL_START SQ>]       | sstate = /sameline_attr          |>> :sameline_attr_after
    |default                  | /sameline_text(:elem_col, ':')   |>> :after_content

  ; A node value (plain :a |beta) is a VALUE, not a child — it does not set
  ; content_seen (attrs-before-children counts children, not values).
  |state[:sameline_attr_after]
    |if[sstate == 2]                                             |>> :sameline_node
    |default                                                     |>> :pre_content

  |state[:sameline_node]
    |c['|']                   | ->                               |>> :sameline_node2
    |default                                                     |>> :pre_content
  |state[:sameline_node2]
    |c['{']                   | -> | /embedded                   |>> :post_child
    |c[<XLBL_START SQ '[' '.?!*+'>] | /element(COL - 1, :elem_col) |>> :post_block_child
    |default                  | /sameline_text(:elem_col, '|')   |>> :after_content

  |state[:check_sameline_pipe]
    |c['{']                   | -> | content_seen = 1 | /embedded |>> :post_child
    |c[<XLBL_START SQ '[' '.?!*+'>]  | content_seen = 1              |>> :check_sameline_elem_col
    |default                  | content_seen = 1 | /sameline_text(:elem_col, '|') |>> :after_content

  ; Check if new element's column requires closing current element first (sibling detection)
  ; Per SPEC: "pop while new_column <= stack_top.base_column"
  |state[:check_sameline_elem_col]
    |if[COL - 1 <= :elem_col]                                     |return
    |                       | /element(COL - 1, :elem_col)        |>> :post_block_child

  ; A block child element consumed its own lines and returned positioned at
  ; the first character of a fresh (dedented) line — run it through the
  ; ordinary children column bookkeeping.
  |state[:post_block_child]
    |eof                      |                                  |return
    |c['\n']                  | ->                               |>> :children
    |default                  | col = COL - 1                    |>> :check_child

  |state[:check_sameline_semi]
    |c['{']                   | -> | /brace_comment              |>> :post_sameline_inline
    |default                  | /line_comment_content            |>> :after_content

  |state[:check_sameline_bang]
    |c['{']                   | -> | /sameline_directive           |>> :post_sameline_inline
    |default                  | /sameline_text(:elem_col, '!')   |>> :after_content

  ; `@` in the sameline scan (0.9: equal footing with `|` — CORE Marker
  ; Recognition): a guarded reference is a reference child of the element;
  ; a failed guard falls back to prose with the '@' restored.
  |state[:check_sameline_at]
    |c[<L XLBL_START '.'>]    | content_seen = 1 | /block_ref     |>> :pre_content
    |default                  | /sameline_text(:elem_col, '@')   |>> :after_content

  ; After inline directive on sameline - don't skip spaces, they're content now
  |state[:post_sameline_inline]
    |c['\n']                  | ->                               |>> :children
    |eof                      |                                  |return
    |default                  | /sameline_text(:elem_col, <>)    |>> :after_content

  ; After a sameline embedded child: whitespace before further content is
  ; PROSE (round-trip fidelity — "|nav |{a} |{b}" keeps the separating
  ; space as Text), so it routes through sameline_text like any other tail.
  |state[:post_child]
    |c['\n']                  | ->                               |>> :children
    |c['|']                   |                                  |>> :check_post_pipe_col
    |default                  | /sameline_text(:elem_col, <>)    |>> :after_content

  ; Check if '|' is at a sibling/dedent column - if so, let :children handle it
  ; This avoids consuming the '|' before knowing if it belongs to a sibling
  |state[:check_post_pipe_col]
    |if[COL <= :elem_col]                                        |>> :children
    |default             | ->                                    |>> :check_sameline_pipe

  ; === Children Loop ===
  ; content_base tracks first child content's column for consistency warnings
  ; For content beyond content_base column, extra spaces are preserved in output
  |state[:children]
    |c['\n']                  | -> | BlankLine                   |>> :after_newline
    |c[' ']                   | -> | col = 1                     |>> :children_ws
    |c['\t']                  | /error(NoTabs) | ->['\n'] | ->       |>>
    |default                  | col = COL - 1                    |>> :check_child

  ; After consuming newline, check if next line is blank/whitespace-only
  |state[:after_newline]
    |eof                      |                                  |return
    |c['\n']                  | -> | BlankLine                   |>>  ; blank line (empty)
    |c[' ']                   | -> | col = 1                     |>> :children_ws
    |c['\t']                  | /error(NoTabs) | ->['\n'] | ->       |>> :children
    |default                  | col = COL - 1                    |>> :check_child

  ; Count spaces, but stop at content_base if set (to preserve extra spaces as content)
  ; If line ends up whitespace-only, emit BlankLine
  |state[:children_ws]
    ; If content_base is set and we've reached it, stop counting
    |if[content_base >= 0 && col >= content_base]               |>> :at_content_base
    |c[' ']                   | -> | col += 1                    |>>
    |c['\n']                  | -> | BlankLine                   |>> :after_newline  ; whitespace-only
    |default                  |                                  |>> :check_child

  ; At content_base - check what follows
  ; We've reached content_base column, now dispatch on character type
  |state[:at_content_base]
    |if[col <= :elem_col]                                        |return  ; dedent
    |c['\n']                  | -> | BlankLine                   |>> :after_newline  ; whitespace-only to content_base
    |c['|']                   | ->                               |>> :child_pipe
    |c[':']                   | ->                               |>> :child_check_attr
    |c['!']                   | ->                               |>> :child_check_bang
    |c[';']                   | -> | /line_comment               |>> :after_content
    |c['@']                   | ->                               |>> :child_check_at
    |c['`']                   | ->                               |>> :child_check_freeform
    |c[<BS>]                  | -> | /verbatim_text              |>> :after_content
    ; For default content (includes space), extra spaces beyond content_base are preserved
    |default                  | content_seen = 1 | /prose(col, :elem_col, <>) |>> :after_content

  |state[:check_child]
    |if[col <= :elem_col]                                        |>> :dedent_out
    |if[attr_open == 1]                                          |>> :attr_pending
    ; After child return, content_base may be set - route to :at_content_base if matched
    |if[content_base >= 0 && col >= content_base]               |>> :at_content_base
    |default                                                     |>> :child_dispatch

  ; Dedent past this element: an open attr never got its value.
  |state[:dedent_out]
    |if[attr_open == 1]       | /error(missing_attribute_value) | Nil | attr_open = 0 |return
    |default                                                     |return

  ; A deferred attribute is open (CORE "Multi-Line Values"): a deeper line
  ; is its value body — a node (the attr IS the node), text (deferred text
  ; value), or a comment (exempt; the attr stays open). A line at or left
  ; of the attr's own column means no value ever arrived: error + Nil.
  ; Deferred values do NOT enter the children phase (attrs-before-children
  ; counts children, not values) — content_seen stays untouched here.
  |state[:attr_pending]
    |if[col <= attr_col]      | /error(missing_attribute_value) | Nil | attr_open = 0 |>> :attr_resolved
    |c['|']                   | attr_open = 0 | ->               |>> :attr_node
    |c[':']                   | /error(attribute_under_attribute) | attr_open = 0 | -> |>> :attr_bad_attr
    |c[';']                   | -> | /line_comment               |>> :after_content_open
    |c['`']                   | attr_open = 0 | ->               |>> :attr_fence
    |c['!']                   | attr_open = 0                    |>> :child_check_bang
    |c[<BS>]                  | attr_open = 0 | -> | /verbatim_text |>> :after_content
    |default                  | attr_open = 0 | /prose(col, :elem_col, <>) |>> :after_content

  |state[:attr_resolved]
    |if[content_base >= 0 && col >= content_base]               |>> :at_content_base
    |default                                                     |>> :child_dispatch

  |state[:attr_node]
    |c['{']                   | -> | /embedded                   |>> :after_content
    |c[<XLBL_START SQ '[' '.?!*+'>] | /element(col, :elem_col)   |>> :after_child
    |default                  | /prose(col, :elem_col, '|')      |>> :after_content

  ; The offending ':'-line after AttributeUnderAttribute is kept as prose
  ; (keep-everything posture; recovery shape is an open supplement item).
  |state[:attr_bad_attr]
    |default                  | /prose(col, :elem_col, ':')      |>> :after_content

  |state[:attr_fence]
    |c['`']                   | ->                               |>> :attr_fence2
    |default                  | /prose(col, :elem_col, '`')      |>> :after_content
  |state[:attr_fence2]
    |c['`']                   | -> | /freeform                   |>> :after_content
    |default                  | /prose_backticks(col, :elem_col) |>> :after_content

  ; First child content (content_base not yet set) or lines with less indent than content_base
  ; content_base tracks the first child's column for consistency warnings
  ; First child content (content_base not yet set) or lines with less indent
  ; than content_base. content_base is a PROSE concept (CORE "Automatic
  ; Prose Dedentation"): only prose lines — and the head-position `\`,
  ; which anchors the base (CORE "Escape") — set it or warn against it.
  ; Child elements, fences, comments, and directives at other columns are
  ; ordinary structure (CORE's own table example mixes columns silently).
  |state[:child_dispatch]
    |c['|']                   | ->                               |>> :child_pipe
    |c[':']                   | ->                               |>> :child_check_attr
    |c['!']                   | ->                               |>> :child_check_bang
    |c[';']                   | -> | /line_comment               |>> :after_content
    |c['@']                   | ->                               |>> :child_check_at
    |c['`']                   | ->                               |>> :child_check_freeform
    |c[<BS>]                  | ->                               |>> :verbatim_base
    |default                  |                                  |>> :prose_base

  |state[:prose_base]
    |if[content_base < 0]     | content_base = col               |>> :do_prose
    |if[col < content_base]   | Warning(InconsistentIndentation) | content_base = col |>> :do_prose
    |default                  |                                  |>> :do_prose

  |state[:verbatim_base]
    |if[content_base < 0]     | content_base = col               |>> :do_verbatim
    |if[col < content_base]   | Warning(InconsistentIndentation) | content_base = col |>> :do_verbatim
    |default                  |                                  |>> :do_verbatim

  |state[:do_verbatim]
    |default                  | content_seen = 1 | /verbatim_text |>> :after_content

  ; `!` guard in element children (see document :check_bang)
  |state[:child_check_bang]
    |c[':']                   | /block_directive(col)            |>> :after_content
    |c[XLBL_START]            | /block_directive(col)            |>> :after_content
    |c['{']                   | -> | /sameline_directive         |>> :after_content
    |default                  | /prose(col, :elem_col, '!')      |>> :after_content

  ; `@` guard in element children (see document :check_at; `.` per 0.9)
  |state[:child_check_at]
    |c[<L XLBL_START '.'>]    | /block_ref                       |>> :after_content
    |default                  | /prose(col, :elem_col, '@')      |>> :after_content

  ; Line-initial attr guard (see document :check_attr): failed attr parse
  ; falls back to intact prose with the ':' restored (defect #12).
  ; Phase restriction (CORE "Attributes Before Children"): once any text or
  ; child element has appeared, a line-initial ':' is prose.
  |state[:child_check_attr]
    |if[content_seen == 1]    | Warning(AttributeAfterChildren) | /prose(col, :elem_col, ':') |>> :after_content
    |c[<XLBL_START SQ>]       | attr_col = col | attr_open = /block_attr |>> :attr_after
    |default                  | /prose(col, :elem_col, ':')      |>> :after_content

  |state[:attr_after]
    |if[attr_open == 2]       | attr_open = 0                    |>> :battr_node
    |if[attr_open == 1]                                          |>> :after_content_open
    |default                                                     |>> :after_content

  ; Block-line sameline node value (:a |node on its own line): parse the
  ; node as the value — again, no content_seen.
  |state[:battr_node]
    |c['|']                   | ->                               |>> :battr_node2
    |default                                                     |>> :after_content
  |state[:battr_node2]
    |c['{']                   | -> | /embedded                   |>> :after_content
    |c[<XLBL_START SQ '[' '.?!*+'>] | /element(COL - 1, :elem_col) |>> :post_block_child
    |default                  | /prose(COL - 1, :elem_col, '|')  |>> :after_content

  ; Parallel EOF-sensitive states while a deferred attribute is open: at
  ; EOF the attr never got a value -> MissingAttributeValue + Nil. (These
  ; exist because the generator's inferred EOF handling runs before any
  ; |if cases; only an explicit unconditional |eof can intercept it.)
  |state[:after_content_open]
    |eof                      | /error(missing_attribute_value) | Nil | attr_open = 0 |return
    |c['\n']                  | ->                               |>> :after_newline_open
    |c[' ']                   | -> | col = 1                     |>> :children_ws
    |c['\t']                  | /error(NoTabs) | ->['\n'] | ->       |>> :after_newline_open
    |default                  | col = COL - 1                    |>> :check_child

  |state[:after_newline_open]
    |eof                      | /error(missing_attribute_value) | Nil | attr_open = 0 |return
    |c['\n']                  | -> | BlankLine                   |>>
    |c[' ']                   | -> | col = 1                     |>> :children_ws
    |c['\t']                  | /error(NoTabs) | ->['\n'] | ->       |>>
    |default                  | col = COL - 1                    |>> :check_child

  |state[:do_prose]
    |default                  | content_seen = 1 | /prose(col, :elem_col, <>) |>> :after_content

  ; Prose handlers go to :after_content to consume trailing \n
  |state[:child_check_freeform]
    |c['`']                   | ->                               |>> :child_check_freeform2
    |default                  | /prose(col, :elem_col, '`')      |>> :after_content

  |state[:child_check_freeform2]
    |c['`']                   | -> | content_seen = 1 | /freeform |>> :after_content
    |default                  | content_seen = 1 | /prose_backticks(col, :elem_col) |>> :after_content

  |state[:child_pipe]
    |c['{']                   | -> | content_seen = 1 | /embedded |>> :after_child
    |c[<XLBL_START SQ '[' '.?!*+'>] | content_seen = 1 | /element(col, :elem_col) |>> :after_child
    |default                  | content_seen = 1 | /prose(col, :elem_col, '|') |>> :after_content

  ; After child element/embedded returns - always re-check column for potential dedent
  |state[:after_child]
    |                                                            |>> :children

  ; After line content (prose, attr, comment, etc.) - consume trailing newline
  ; This ensures :children only sees \n when at true line-start (blank line)
  ; If content returned early (e.g., line_comment on dedent), re-dispatch mid-line
  |state[:after_content]
    |c['\n']                  | ->                               |>> :after_newline
    |eof                      |                                  |return
    |c[' ']                   | -> | col = 1                     |>> :children_ws
    |c['\t']                  | /error(NoTabs) | ->['\n'] | ->       |>>
    |default                  | col = COL - 1                    |>> :check_child


; ============================================================================
; Names (element/class names)
; ============================================================================

; 0.9 charset: `/` is a name-continue character — conventional namespacing
; with zero core semantics (|acme/widget). CORE "Bare-name characters".
|function[name:Name]  | MARK
  |state[:main]
    |c[<XLBL_CONT '/'>]       | ->                               |>>
    |default                  | TERM                             |return


; DRYed: skip_single_quoted - void helper for '-quoted content with escapes
; Stops AT closing ' (doesn't consume). Caller does TERM | -> to consume.
; NOTE: Can't use ->[<SQ>] because we need to handle \' escapes
|function[skip_single_quoted]
  |state[:main]
    |c[<SQ>]                  |                                  |return  ; don't consume
    |c[<BS>]                  | -> | ->                          |>>
    |default                  | ->                               |>>


|function[quoted_name:Name]  | MARK
  |state[:main]
    | /skip_single_quoted | TERM | ->                            |return


; A bare trait's continue-set is XID_Continue + '-' + '/' PLUS the suffix
; chars * ! ? + (CORE "Element Suffixes": a suffix char touching a trait is
; part of the trait — `.foo?` is the trait "foo?"; '/' per 0.9 charset).
|function[class_name:BareValue]  | MARK
  |state[:main]
    |c[<XLBL_CONT '/?!*+'>]   | ->                               |>>
    |default                  | TERM                             |return


|function[quoted_class:StringValue]  | MARK
  |state[:main]
    | /skip_single_quoted | TERM | ->                            |return


; ============================================================================
; Attributes
; ============================================================================

|function[suffix]
  |state[:main]
    |c['?']                   | Attr($?) | BoolTrue | ->          |return
    |c['!']                   | Attr($!) | BoolTrue | ->          |return
    |c['*']                   | Attr($*) | BoolTrue | ->          |return
    |c['+']                   | Attr($+) | BoolTrue | ->          |return
    |default                  |                                  |return


; 0.9 attribute model (CORE "Attribute Keys and Flags"): a terminal '?' on
; the key selects flag semantics (detected via PREV after /attr_key — the
; last consumed byte is the key's last char). Plain attributes always take
; a value: a valueless plain attr is a non-halting MissingAttributeValue
; error + a synthesized Nil (the stream never carries less shape than the
; source suggested; ruled 2026-07-16). A '|' in value position is left
; unconsumed with NO event — the caller parses the node, and on the flat
; wire "Attr followed by ElementStart" IS the node-value encoding.
; KNOWN GAPS (fixture-red, staged): quoted flag keys (:'ready?' — needs
; last-content-byte tracking through the quote scan); deferred block values
; (:key at EOL + deeper lines — needs attr-open state in the element loop,
; pass 1c).

; Returns 1 when the attribute is left OPEN at end-of-line (deferred value:
; deeper lines are the body — the caller's children loop resolves it, or
; errors MissingAttributeValue+Nil if nothing deeper claims it). Uniform
; scan (CORE "The Scan"): after a finished value, ':' starts the next
; attribute on the SAME block line; block run-to-EOL is gone.
|function[block_attr:INT]  | result = 0
  |state[:key]
    |c[XLBL_START]            | /attr_key                        |>> :post_key
    |c[<SQ>]                  | -> | /attr_key_quoted            |>> :post_qkey

  ; PREV after /attr_key is the key's last char; after /attr_key_quoted the
  ; closing quote is NOT yet consumed, so PREV is the last CONTENT char —
  ; flag semantics follow the name whether quoted or bare (R4, 2026-07-16).
  |state[:post_key]
    |if[PREV == '?']                                             |>> :flag
    |default                                                     |>> :value_start

  |state[:post_qkey]
    |if[PREV == '?']          | ->                               |>> :flag
    |default                  | ->                               |>> :value_start

  |state[:flag]
    | /flag_value('\0')                                          |>> :post_value

  |state[:value_start]
    |c[' \t']                 | ->                               |>>
    |c['\n']                  | result = 1                       |return result
    |c[':']                   | /error(missing_attribute_value) | Nil |>> :key_next
    |c['|']                   | result = 2                       |return result
    |c[<BS>]                  | -> | /attr_text_verbatim('\0')   |return result
    |default                  | /value(0, '\0')                  |>> :post_value

  ; Consume the ':' that ended a valueless attr and parse the next key.
  |state[:key_next]
    |c[':']                   | ->                               |>> :key
    |default                  |                                  |return result

  ; After a finished value: framed comment, next attribute (uniform scan),
  ; or end of line. Trailing text / boundary-\ after a FINISHED value is
  ; the warn+stack segment case — staged (needs re-emittable key); interim
  ; the material is left to the caller so no bytes are lost.
  |state[:post_value]
    |c[' \t']                 | ->                               |>>
    |c[';']                   | -> | /line_comment_content        |return result
    |c[':']                   |                                  |>> :key_next
    |default                  |                                  |return result


; Returns 2 when a '|' follows in value position — the node is the attr's
; VALUE (parsed by the caller without entering the children phase).
|function[sameline_attr:INT]  | result = 0
  |state[:key]
    |c[XLBL_START]            | /attr_key                        |>> :post_key
    |c[<SQ>]                  | -> | /attr_key_quoted            |>> :post_qkey

  ; PREV after /attr_key is the key's last char; after /attr_key_quoted the
  ; closing quote is NOT yet consumed, so PREV is the last CONTENT char —
  ; flag semantics follow the name whether quoted or bare (R4, 2026-07-16).
  |state[:post_key]
    |if[PREV == '?']                                             |>> :flag
    |default                                                     |>> :value_start

  |state[:post_qkey]
    |if[PREV == '?']          | ->                               |>> :flag
    |default                  | ->                               |>> :value_start

  |state[:flag]
    | /flag_value('\0')                                          |return result

  |state[:value_start]
    |c[' \t']                 | ->                               |>>
    |c['\n:']                 | /error(missing_attribute_value) | Nil |return result
    |c['|']                   | result = 2                       |return result
    |c[<BS>]                  | -> | /attr_text_verbatim('\0')   |return result
    |default                  | /value(0, '\0')                  |return result


|function[sameline_attr_embedded]
  |state[:key]
    |c[XLBL_START]            | /attr_key                        |>> :post_key
    |c[<SQ>]                  | -> | /attr_key_quoted            |>> :post_qkey

  ; PREV after /attr_key is the key's last char; after /attr_key_quoted the
  ; closing quote is NOT yet consumed, so PREV is the last CONTENT char —
  ; flag semantics follow the name whether quoted or bare (R4, 2026-07-16).
  |state[:post_key]
    |if[PREV == '?']                                             |>> :flag
    |default                                                     |>> :value_start

  |state[:post_qkey]
    |if[PREV == '?']          | ->                               |>> :flag
    |default                  | ->                               |>> :value_start

  |state[:flag]
    | /flag_value('}')                                           |return

  |state[:value_start]
    |c[' \t']                 | ->                               |>>
    |c[<'\n:' '}'>]           | /error(missing_attribute_value) | Nil |return
    |c['|']                   |                                  |return
    |c[<BS>]                  | -> | /attr_text_verbatim('}')     |return
    |default                  | /value(0, '}')                   |return


; Flag value (CORE flag rule): exactly true/false/null/nil as the next token
; is the flag's value (consumed, even with trailing material — the keyword
; ate); anything else snaps the flag to true. A non-keyword TOKEN commits the
; rest of the line to a text blob (the first prose word ends the scan); a
; marker in value position leaves the material to the continuing scan.
|function[flag_value]  :bracket
  |state[:start]
    |eof                      | BoolTrue                         |return
    |c[' \t']                 | ->                               |>>
    |c['\n']                  | BoolTrue                         |return
    |c[:bracket]              | BoolTrue                         |return
    |c[<':;!@`' P BS>]        | BoolTrue                         |return
    |c[LETTER]                | MARK | ->                        |>> :token
    |default                  | MARK | BoolTrue | ->             |>> :blob

  |state[:token]
    |eof                      | TERM | KEYWORDS(flag_kw)         |return
    |c[LABEL_CONT]            | ->                               |>>
    |c['\n']                  | TERM | KEYWORDS(flag_kw)         |return
    |c[' \t']                 | TERM | KEYWORDS(flag_kw)         |return
    |c[:bracket]              | TERM | KEYWORDS(flag_kw)         |return
    |default                  | BoolTrue | ->                    |>> :blob

  ; Snapped true; the token begins a blob to end-of-line (bracket-aware).
  |state[:blob]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c[:bracket]              | TERM | Text(USE_MARK)            |return
    |default                  | ->                               |>>


; KEYWORDS fallback for flag_value: a lone non-keyword token — the flag
; snapped to true and the token begins a blob to end-of-line (uses the
; caller's MARK; re-TERMs at the blob end).
|function[flag_snap_blob]
  |state[:main]
    | BoolTrue                                                   |>> :blob
  |state[:blob]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c['}']                   | TERM | Text(USE_MARK)            |return
    |default                  | ->                               |>>


|keywords[flag_kw] :fallback /flag_snap_blob
  | true   => BoolTrue
  | false  => BoolFalse
  | null   => Nil
  | nil    => Nil


; 0.9 key charset (CORE "Attribute Keys and Flags"): XID_Continue + '-' +
; '/' + the suffix chars '?!*+', all unquoted. A TERMINAL '?' selects flag
; semantics — callers detect it via PREV == '?' after this returns (the
; last consumed byte is the key's last character).
|function[attr_key:Attr]  | MARK
  |state[:main]
    |c[<XLBL_CONT '/?!*+'>]   | ->                               |>>
    |default                  | TERM                             |return


; Stops AT the closing quote (unconsumed) so callers can read PREV = the
; last content character for terminal-'?' flag detection before consuming.
|function[attr_key_quoted:Attr]  | MARK
  |state[:main]
    | /skip_single_quoted | TERM                                 |return


; ============================================================================
; References
; ============================================================================

; Reference (CORE "References", `@`-inert): called with the `@` consumed and
; the current char passing the guard (`[`, `.`, or identifier start). The
; payload is the RAW TEXT after `@` — `@[mit]` -> "[mit]",
; `@license[mit].realized` -> "license[mit].realized" — one uniform rule, no
; information loss (interim wire; structured encoding is a SPEC-CORE open
; item). Trait tails (`.trait`) continue the reference both before and after
; the `[key]` (0.9: selector tuples incl. trait-only `@.realized`). The old
; `:[id]` attribute-merge form is REMOVED (merge is a host resolution mode).
|function[block_ref:Reference]  | MARK
  |state[:main]
    |c['[']                   | ->[']'] | ->                     |>> :post_key
    |c[<XLBL_CONT '.'>]       | ->                               |>>
    |default                  | TERM                             |return

  ; After `[key]`: trait selectors may follow (`@el[key].trait.more`)
  |state[:post_key]
    |c[<XLBL_CONT '.'>]       | ->                               |>>
    |default                  | TERM                             |return


; ============================================================================
; Values
; ============================================================================

; Value parsing - unified function with context parameters
;   :space_term = 0 (block: space is content) or 1 (space terminates)
;   :bracket = 0 (none), '}' (embedded), ']' (array)
|function[value]  :space_term :bracket
  |state[:start]
    |c[<DQ>]                  | -> | /double_quoted              |return
    |c[<SQ>]                  | -> | /single_quoted              |return
    |c['[']                   | /array                           |return  ; array owns its delimiter
    |default                  | MARK | /typed_value(:space_term, :bracket) |return

; (value_bracket removed 2026-07-15: [key] values now route through the
; typed /value path — CORE "Identity": every type is available in brackets,
; [1] is the integer 1, ["01"] the string "01".)

; Quoted string parsing - separate functions for each quote type
; (parameterized version had scan optimization issues with :quote)
|function[double_quoted:StringValue]  | MARK
  |state[:main]
    |c[<DQ>]                  | TERM | ->                        |return
    |c[<BS>]                  | -> | ->                          |>>
    |default                  | ->                               |>>

|function[single_quoted:StringValue]  | MARK
  |state[:main]
    |c[<SQ>]                  | TERM | ->                        |return
    |c[<BS>]                  | -> | ->                          |>>
    |default                  | ->                               |>>

; Array - items are space-separated, ] terminates
; Array owns its delimiter; items are values (quotes, nested arrays, typed values)
|function[array:Array]
  |state[:entry]
    |c['[']  | ->                                                 |>> :items
  |state[:items]
    |c[']']  | ->                                                 |return
    |c[' \t\n'] | ->                                              |>>
    |default | /value(1, ']')                                     |>>


; ============================================================================
; Prose / Text
; ============================================================================

; attr_text_verbatim - value-position `\` (CORE "Value-Position \"): the
; backslash was consumed by the caller; the rest of the line (or the
; embedded bracket) is the attribute's TEXT value — literal, no sameline
; comment affordance (P3-3).
|function[attr_text_verbatim:Text]  :bracket
  |state[:main]
    |c['\n']                  | TERM                             |return
    |c[:bracket]              | TERM                             |return
    |default                  | ->                               |>>


; verbatim_text - head-position `\` escape (CORE "Escape (\)"): the
; backslash was consumed by the caller; the REST OF THE PHYSICAL LINE is
; prose, read verbatim - no inline forms, no marker interpretation. The
; consumed `\` takes no column: callers set content_base to the `\`'s
; column exactly as for ordinary first-line prose. Trailing newline is left
; for the caller's line loop.
|function[verbatim_text:Text]  | ->['\n'] | TERM

; prose - block-level text content with optional prepend character
; :prepend = <> (none), '|' (pipe prefix), '`' (backtick prefix)
|function[prose]  :line_col :parent_col :prepend
  |if[:parent_col >= 0 && :line_col <= :parent_col]          |return  ; dedent

  |state[:content]
    | /text(:line_col, :parent_col, :prepend)                    |return


; prose_backticks - two backticks (not freeform, just text starting with ``)
|function[prose_backticks]  :line_col :parent_col
  |if[:parent_col >= 0 && :line_col <= :parent_col]          |return

  |state[:content]
    | /text_backticks(:line_col, :parent_col)                    |return


; text_backticks - text that starts with `` (for non-freeform case)
; Manual emit control, no :Text auto-emit
; Semicolons in prose are LITERAL - only `;{...}` triggers inline comment
|function[text_backticks]  :line_col :parent_col
  |state[:entry]
    | MARK | PREPEND('`') | PREPEND('`')                         |>> :main

  |state[:main]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c['|']                   | ->                               |>> :check_pipe
    |c[';']                   | ->                               |>> :check_semi
    |c['!']                   | ->                               |>> :check_bang
    |c[<BS>]                  | ->                               |>> :check_bs
    |default                  | ->                               |>>

  |state[:check_pipe]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include | in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /embedded |>> :after_inline
    |default                  |                                  |>> :main

  ; Semicolons in prose are LITERAL - only `;{...}` triggers inline comment
  |state[:check_semi]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ; in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /brace_comment |>> :after_inline
    |default                  |                                  |>> :main  ; semicolon is literal

  |state[:check_bang]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ! in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /sameline_directive |>> :after_inline
    |default                  |                                  |>> :main


  ; In prose flow, `\` escapes exactly the inline openers |{ !{ ;{ (CORE
  ; "Escape"): the `\` is dropped and the opener is literal. Any other `\`
  ; is literal (already accumulated). NOTE: the emit splits the Text event
  ; at the escape point (one accumulation slice) - granularity is not
  ; spec-fixed; see spec/TODO-SPEC-CORE.md.
  |state[:check_bs]
    |c['|']                   | ->                               |>> :check_bs_pipe
    |c['!']                   | ->                               |>> :check_bs_bang
    |c[';']                   | ->                               |>> :check_bs_semi
    |default                  |                                  |>> :main
  |state[:check_bs_pipe]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('|') |>> :main
    |default                  |                                  |>> :main
  |state[:check_bs_bang]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('!') |>> :main
    |default                  |                                  |>> :main
  |state[:check_bs_semi]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND(';') |>> :main
    |default                  |                                  |>> :main

  ; After inline construct - only set MARK if more content follows
  |state[:after_inline]
    |c['\n']                  |                                  |return  ; at end, no emit
    |eof                      |                                  |return  ; at end, no emit
    |default                  | MARK                             |>> :main


; ============================================================================
; Freeform Blocks (```)
; ============================================================================

; Freeform block - captures content until closing ``` at start of any line
; Preserves exact whitespace - no dedentation
; Closing ``` detected when line starts with optional whitespace then ```
|function[freeform:Freeform]
  ; Opening line: everything after the backticks begins the body (CORE
  ; "Triple-Backtick Escape" — an info string is just the body's first
  ; content; there is no separate info-string rule).
  |state[:opening]
    |c['\n']                  | ->                               |>> :line_start
    |default                  | MARK | ->['\n'] | TERM | Text(USE_MARK) | -> |>> :line_start

  ; Start of each content line - MARK immediately, then check content
  ; Blank lines are content: freeform's contract is exact preservation
  ; (defect #15), so they emit BlankLine instead of vanishing.
  |state[:line_start]
    |c['\n']                  | -> | BlankLine                   |>>  ; blank line preserved
    |default                  | MARK                             |>> :content

  ; Check if line is closing ``` (starts with optional ws then ```)
  ; A whitespace-only line is exact content: emit it as Text rather than
  ; letting its newline leak into the next line's Text (defect #15).
  |state[:content]
    |c[' \t']                 | ->                               |>>
    |c['\n']                  | TERM | Text(USE_MARK) | ->       |>> :line_start  ; ws-only line
    |c['`']                   | ->                               |>> :maybe_end1
    |default                  | ->                               |>> :line

  |state[:line]
    | ->['\n'] | TERM | Text(USE_MARK) | ->                      |>> :line_start

  ; Check for ``` sequence
  |state[:maybe_end1]
    |c['`']                   | ->                               |>> :maybe_end2
    |default                  |                                  |>> :line  ; only one `, continue

  |state[:maybe_end2]
    |c['`']                   | ->                               |>> :post_close
    |default                  |                                  |>> :line  ; only ``, continue

  ; A closer must be followed by a newline; whitespace to the right of the
  ; backticks is ignored (CORE). Anything else means the line is body.
  |state[:post_close]
    |eof                      |                                  |return
    |c[' \t']                 | ->                               |>>
    |c['\n']                  | ->                               |return
    |default                  |                                  |>> :line


; text - block-level prose content (manual emit control, no :Text auto-emit)
; Same pattern as sameline_text: advance past special chars, check what follows.
; :prepend = <> (none), '|' (pipe prefix), '`' (backtick prefix)
; Semicolons in prose are LITERAL - only `;{...}` triggers inline comment
; (`;` at line start is handled by document/element children loop, not here)
|function[text]  :line_col :parent_col :prepend
  |state[:entry]
    | MARK | PREPEND(:prepend)                                   |>> :main

  |state[:main]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c['|']                   | ->                               |>> :check_pipe
    |c[';']                   | ->                               |>> :check_semi
    |c['!']                   | ->                               |>> :check_bang
    |c[<BS>]                  | ->                               |>> :check_bs
    |default                  | ->                               |>>

  |state[:check_pipe]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include | in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /embedded |>> :after_inline
    |default                  |                                  |>> :main

  ; Semicolons in prose are LITERAL - only `;{...}` triggers inline comment
  |state[:check_semi]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ; in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /brace_comment |>> :after_inline
    |default                  |                                  |>> :main  ; semicolon is literal

  |state[:check_bang]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ! in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /sameline_directive |>> :after_inline
    |default                  |                                  |>> :main


  ; In prose flow, `\` escapes exactly the inline openers |{ !{ ;{ (CORE
  ; "Escape"): the `\` is dropped and the opener is literal. Any other `\`
  ; is literal (already accumulated). NOTE: the emit splits the Text event
  ; at the escape point (one accumulation slice) - granularity is not
  ; spec-fixed; see spec/TODO-SPEC-CORE.md.
  |state[:check_bs]
    |c['|']                   | ->                               |>> :check_bs_pipe
    |c['!']                   | ->                               |>> :check_bs_bang
    |c[';']                   | ->                               |>> :check_bs_semi
    |default                  |                                  |>> :main
  |state[:check_bs_pipe]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('|') |>> :main
    |default                  |                                  |>> :main
  |state[:check_bs_bang]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('!') |>> :main
    |default                  |                                  |>> :main
  |state[:check_bs_semi]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND(';') |>> :main
    |default                  |                                  |>> :main

  ; After inline construct - only set MARK if more content follows
  |state[:after_inline]
    |c['\n']                  |                                  |return  ; at end, no emit
    |eof                      |                                  |return  ; at end, no emit
    |default                  | MARK                             |>> :main


; sameline_text - text on same line as element (manual emit control, no :Text auto-emit)
; When special chars (|;!) are encountered, we advance past them, then check
; what follows. If special construct, emit text before it and parse construct.
; If not special, just continue (char is included in text).
; :prepend = <> (none), '|' (pipe prefix), '!' (bang prefix)
|function[sameline_text]  :elem_col :prepend
  |state[:entry]
    | MARK | PREPEND(:prepend)                                   |>> :main

  |state[:main]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c['|']                   | ->                               |>> :check_pipe
    |c[';']                   |                                  |>> :check_semi
    |c['!']                   | ->                               |>> :check_bang
    |c[<BS>]                  | ->                               |>> :check_bs
    |default                  | ->                               |>>

  |state[:check_pipe]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include | in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /embedded |>> :after_inline
    |c[<XLBL_START SQ '[' '.?!*+'>] |                               |>> :check_pipe_elem_col
    |default                  |                                  |>> :main

  ; Check if inline element's column requires closing current element first
  |state[:check_pipe_elem_col]
    |if[COL - 1 <= :elem_col] | TERM(-1) | Text(USE_MARK)         |return
    |                        | TERM(-1) | Text(USE_MARK) | /element(COL - 1, :elem_col) |>> :after_inline

  ; Sameline comment (CORE "Sameline Comments", ratified 2026-07-15): a `;`
  ; opens a comment after prose ONLY when whitespace-framed — space before,
  ; space or end-of-line after. `;{` (inline comment) needs no frame.
  ; Routed here WITHOUT consuming, so PREV is the char before the `;`.
  |state[:check_semi]
    |if[PREV == ' ']          | ->                               |>> :semi_spaced
    |default                  | ->                               |>> :semi_glued

  |state[:semi_spaced]
    |eof                      | TERM(-1) | Text(USE_MARK) | /line_comment_content |return
    |c['\n']                  | TERM(-1) | Text(USE_MARK) | /line_comment_content |return
    |c[' ']                   | TERM(-1) | Text(USE_MARK) | /line_comment_content |return
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /brace_comment |>> :after_inline
    |default                  |                                  |>> :main  ; ";x" — unframed, literal

  |state[:semi_glued]
    |eof                      | TERM | Text(USE_MARK)            |return  ; literal ;
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /brace_comment |>> :after_inline
    |default                  |                                  |>> :main  ; literal ;

  |state[:check_bang]
    |eof                      | TERM | Text(USE_MARK)            |return  ; include ! in text
    |c['{']                   | TERM(-1) | Text(USE_MARK) | -> | /sameline_directive |>> :after_inline
    |default                  |                                  |>> :main


  ; In prose flow, `\` escapes exactly the inline openers |{ !{ ;{ (CORE
  ; "Escape"): the `\` is dropped and the opener is literal. Any other `\`
  ; is literal (already accumulated). NOTE: the emit splits the Text event
  ; at the escape point (one accumulation slice) - granularity is not
  ; spec-fixed; see spec/TODO-SPEC-CORE.md.
  |state[:check_bs]
    |c['|']                   | ->                               |>> :check_bs_pipe
    |c['!']                   | ->                               |>> :check_bs_bang
    |c[';']                   | ->                               |>> :check_bs_semi
    |default                  |                                  |>> :main
  |state[:check_bs_pipe]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('|') |>> :main
    |default                  |                                  |>> :main
  |state[:check_bs_bang]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('!') |>> :main
    |default                  |                                  |>> :main
  |state[:check_bs_semi]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND(';') |>> :main
    |default                  |                                  |>> :main

  ; After inline construct - only set MARK if more content follows
  |state[:after_inline]
    |c['\n']                  |                                  |return  ; at end, no emit
    |eof                      |                                  |return  ; at end, no emit
    |default                  | MARK                             |>> :main


; ============================================================================
; Comments
; ============================================================================
;
; Comment is a BRACKET type (like Element, Directive) - emits CommentStart/End.
; Content inside is emitted as Text events.
;
; This allows comment continuation (SPEC 419-428) to use the same "children loop"
; pattern as Element and Directive, DRYing the indentation-based block handling.

; Block-level line comment - can have continuation (SPEC 419-428)
; Called after `;` consumed at block level
; Uses content_base like prose: first continuation line sets the base column,
; subsequent lines are normalized relative to that base.
|function[line_comment:Comment]  | comment_col = COL - 1 | content_base = -1
  |state[:check]
    |c['{']                   | -> | /comment_text_braced        |return
    |default                  | MARK                             |>> :first_line

  ; First line of comment content (the part after `;`)
  |state[:first_line]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK) | ->       |>> :children
    |default                  | ->                               |>>

  ; Children loop - check for continuation lines
  ; Per SPEC 419-428: more-indented lines without prefix are continuation
  |state[:children]
    |eof                      |                                  |return
    |c['\n']                  | ->                               |>>  ; blank line
    |c[' ']                   | -> | col = 1                     |>> :children_ws
    |c['\t']                  |                                  |return  ; tab = end
    |default                  |                                  |return  ; non-indented = end

  ; Count spaces, but stop at content_base if set (like prose does)
  |state[:children_ws]
    ; If content_base is set and we've reached it, stop counting here
    |if[content_base >= 0 && col >= content_base]               |>> :at_content_base
    |c[' ']                   | -> | col += 1                    |>>
    |default                  |                                  |>> :check_continuation

  ; Finished counting (hit non-space) - check if valid continuation.
  ; UNIFORM (ratified 2026-07-15): every deeper line is comment text —
  ; markers included; only dedent-or-same-column ends the comment.
  |state[:check_continuation]
    |if[col <= comment_col]                                      |return  ; dedent or same col
    ; col > comment_col: this is a continuation line
    ; If content_base not set, first continuation sets it
    |if[content_base < 0]     | content_base = col | MARK        |>> :cont_line
    ; col < content_base: inconsistent indent, warn and reset
    |default                  | Warning(InconsistentIndentation) | content_base = col | MARK |>> :cont_line

  ; Reached content_base while counting - MARK here, extra spaces are content
  |state[:at_content_base]
    |default                  | MARK                             |>> :cont_content

  ; Consume extra spaces (beyond content_base) as content
  |state[:cont_content]
    |c[' ']                   | ->                               |>>
    |default                  |                                  |>> :cont_line

  |state[:cont_line]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK) | ->       |>> :children
    |default                  | ->                               |>>


; Sameline comment - no continuation possible (content ends at newline/EOF)
; Called after `;` consumed in sameline context
|function[line_comment_content:Comment]  | MARK | ->['\n'] | TERM | Text(USE_MARK)


; DRYed: skip_brace_balanced - void helper for {}-counting
; Caller handles MARK/TERM and emit type. Assumes opening { already consumed.
; Returns with position AT the closing } (not consumed)
|function[skip_brace_balanced]  | depth = 1
  |state[:main]
    |c['{']                   | -> | depth += 1                  |>>
    |c['}']                   | depth -= 1                       |>> :check
    |default                  | ->                               |>>

  |state[:check]
    |if[depth == 0]                                              |return  ; stop before }
    | ->                                                         |>> :main  ; consume } and continue


; Brace comment ;{...} - BRACKET type like line_comment
; Called after ;{ consumed
|function[brace_comment:Comment]
  |state[:main]
    | /comment_text_braced                                       |return


; Helper: capture brace-balanced content as Text
|function[comment_text_braced]  | MARK
  |state[:main]
    | /skip_brace_balanced | TERM | Text(USE_MARK) | ->          |return


; ============================================================================
; Embedded |{...}
; ============================================================================

; DRYed: embedded uses shared parse_element_identity with } as closer
|function[embedded:Embedded]

  |state[:identity]
    | /parse_element_identity('}')                               |>> :post_identity

  |state[:post_identity]
    |c['}']                  | ->                               |return  ; empty or identity-only
    |c[' \t']                 | ->                               |>> :pre_content
    |default                  | /embed_content                   |return

  |state[:pre_content]
    |c['}']                  | ->                               |return
    |c[' \t']                 | ->                               |>>
    |c['\n']                  | ->                               |>> :pre_content_ml
    |c[':']                   | ->                               |>> :check_attr
    |c[<BS>]                  | -> | /attr_text_verbatim('}')    |>> :post_identity
    |default                  | /embed_content                   |return

  ; Newline directly after identity/attributes: skip continuation
  ; indentation (ignored inside |{...}) without emitting an empty Text.
  |state[:pre_content_ml]
    |c[' \t\n']               | ->                               |>>
    |c['}']                  | ->                               |return
    |default                  | /embed_content                   |return

  ; Embedded attr guard: failed attr parse falls back to intact content
  ; with the ':' restored (defect #12 data-loss half).
  |state[:check_attr]
    |c[<XLBL_START SQ>]       | /sameline_attr_embedded          |>> :pre_content
    |default                  | PREPEND(':') | /embed_content    |return


; embed_content - text content inside |{...}
; Handles: text, embedded elements, comments, directives, quoted strings
; Quoted strings are emitted as StringValue to avoid brace confusion
|function[embed_content:Text]  | MARK
  |state[:main]
    |c['}']                  | TERM | ->                        |return
    |c['\n']                  | TERM | Text(USE_MARK) | ->       |>> :ml_ws
    |c['|']                   | TERM | ->                        |>> :check_pipe
    |c[';']                   | TERM | ->                        |>> :check_semi
    |c['!']                   | TERM | ->                        |>> :check_bang
    |c[<DQ>]                  | TERM | Text(USE_MARK) | -> | /double_quoted | MARK |>> :main
    |c[<SQ>]                  | TERM | Text(USE_MARK) | -> | /single_quoted | MARK |>> :main
    |c[<BS>]                  | ->                               |>> :check_bs
    |default                  | ->                               |>>

  |state[:check_pipe]
    ; Inside embedded, only |{...} allowed - emit accumulated text first.
    ; A bare marker is literal: emit the accumulated slice too (the harness
    ; Text-collapse rejoins it), then continue with the marker restored.
    |c['{']                   | Text(USE_MARK) | -> | /embedded | MARK |>> :main
    |default                  | Text(USE_MARK) | MARK | PREPEND('|') |>> :main

  |state[:check_semi]
    ; Brace comment - emit accumulated text first
    |c['{']                   | Text(USE_MARK) | -> | /brace_comment | MARK |>> :main
    |default                  | Text(USE_MARK) | MARK | PREPEND(';') |>> :main

  |state[:check_bang]
    ; Inline directive - emit accumulated text first
    |c['{']                   | Text(USE_MARK) | -> | /sameline_directive | MARK |>> :main
    |default                  | Text(USE_MARK) | MARK | PREPEND('!') |>> :main

  ; `\` escaping an inline opener inside |{...} (see text's :check_bs)
  |state[:check_bs]
    |c['|']                   | ->                               |>> :check_bs_pipe
    |c['!']                   | ->                               |>> :check_bs_bang
    |c[';']                   | ->                               |>> :check_bs_semi
    |default                  |                                  |>> :main
  |state[:check_bs_pipe]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('|') |>> :main
    |default                  |                                  |>> :main
  |state[:check_bs_bang]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND('!') |>> :main
    |default                  |                                  |>> :main
  |state[:check_bs_semi]
    |c['{']                   | TERM(-2) | Text(USE_MARK) | MARK | PREPEND(';') |>> :main
    |default                  |                                  |>> :main

  ; Embedded elements span lines; indentation inside is ignored (CORE
  ; "Bracket Mode Rules") — content is delivered per line, continuation
  ; indentation skipped.
  |state[:ml_ws]
    |c[' \t']                 | ->                               |>>
    |default                  | MARK                             |>> :main


; ============================================================================
; Block Directives
; ============================================================================

; Block directive - !name or !:lang: for raw, or !{...} inline at document level
|function[block_directive:Directive]  :line_col  | raw_base = -1
  |state[:dispatch]
    |c[':']                   | ->                               |>> :raw_kind
    |c[XLBL_START]                | /name                            |>> :after_name
    |default                  |                                  |return  ; unreachable (callers guard)

  ; Raw block !:lang: - parse kind name
  |state[:raw_kind]
    |c[XLBL_START]                | /name | Raw                      |>> :raw_colon
    |default                  |                                  |return  ; malformed !:

  |state[:raw_colon]
    |c[':']                   | ->                               |>> :raw_eol
    |default                  |                                  |return  ; missing second :

  |state[:raw_eol]
    |c['\n']                  | ->                               |>> :raw_content
    |c[' \t']                 | ->                               |>>
    |default                  | ->                               |>>  ; consume rest of line

  ; Raw content — captured at greater indent, dedented relative to the
  ; FIRST content line's column (raw_base); deeper lines keep their extra
  ; indent as content (CORE "Raw Directives": relative indent preserved).
  |state[:raw_content]
    |c['\n']                  | ->                               |>>
    |c[' ']                   | -> | col = 1                     |>> :raw_ws
    |default                  |                                  |return  ; non-indented, done

  |state[:raw_ws]
    |if[raw_base >= 0 && col >= raw_base]                        |>> :raw_at_base
    |c[' ']                   | -> | col += 1                    |>>
    |c['\n']                  | ->                               |>> :raw_content  ; ws-only line
    |default                  |                                  |>> :raw_checkbase

  |state[:raw_checkbase]
    |if[col <= :line_col]                                         |return  ; dedent
    |if[raw_base < 0]         | raw_base = col | MARK            |>> :raw_line
    |default                  | MARK                             |>> :raw_line  ; shallower than base: capture as-is

  |state[:raw_at_base]
    |default                  | MARK                             |>> :raw_line  ; extra spaces beyond base are content

  |state[:raw_line]
    |eof                      | TERM | RawContent(USE_MARK)      |return
    |c['\n']                  | TERM | RawContent(USE_MARK) | -> |>> :raw_content
    |default                  | ->                               |>>

  ; Regular directive - parse condition/args and children
  |state[:after_name]
    |c['\n']                  | ->                               |>> :children
    |c[' \t']                 | ->                               |>> :condition
    |default                  |                                  |>> :children

  |state[:condition]
    |c['\n']                  | ->                               |>> :children
    |default                  | MARK | /directive_args           |>> :children

  ; Children at greater indent
  |state[:children]
    |c['\n']                  | ->                               |>>
    |c[' ']                   | col = /count_indent              |>> :check_child
    |c['\t']                  | /error(NoTabs) | ->['\n'] | ->       |>>
    |default                  | col = COL - 1                    |>> :check_child

  |state[:check_child]
    |if[col <= :line_col]                                         |return
    |                                                            |>> :child_dispatch

  |state[:child_dispatch]
    |c['|']                   | ->                               |>> :child_pipe
    |c[':']                   | ->                               |>> :child_check_attr
    |c['!']                   | ->                               |>> :dchild_check_bang
    |c[';']                   | -> | /line_comment               |>> :children
    |c[<BS>]                  | -> | /verbatim_text              |>> :children
    |default                  | /prose(col, :line_col, <>)       |>> :children

  ; `!` guard in directive children (see document :check_bang)
  |state[:dchild_check_bang]
    |c[':']                   | /block_directive(col)            |>> :children
    |c[XLBL_START]            | /block_directive(col)            |>> :children
    |c['{']                   | -> | /sameline_directive         |>> :children
    |default                  | /prose(col, :line_col, '!')      |>> :children

  ; Line-initial attr guard (see document :check_attr): failed attr parse
  ; falls back to intact prose with the ':' restored (defect #12).
  |state[:child_check_attr]
    |c[<XLBL_START SQ>]       | dstate = /block_attr             |>> :dattr_check
    |default                  | /prose(col, :line_col, ':')      |>> :children

  |state[:dattr_check]
    |if[dstate == 1]          | /error(missing_attribute_value) | Nil |>> :children
    |default                  |                                  |>> :children

  |state[:child_pipe]
    |c['{']                   | -> | /embedded                   |>> :children
    |c[<XLBL_START SQ '[' '.?!*+'>] | /element(col, :line_col)         |>> :children
    |default                  | /prose(col, :line_col, '|')      |>> :children


; Directive arguments - capture until newline or EOF
|function[directive_args:Text]  | ->['\n'] | TERM


; Inline dynamics - dispatch based on first char after {
; Called with position at first char inside braces
|function[sameline_directive]
  |state[:dispatch]
    |c['{']                   | -> | /interpolation              |return  ; !{{expr}}
    |c[':']                   | -> | /sameline_raw                 |return  ; !{:kind: content}
    |default                  | /sameline_dir_body                 |return  ; !{name args}


; Interpolation !{{expr}} - double-brace, must close with }}
|function[interpolation:Interpolation]  | MARK
  |state[:main]
    |eof                      | TERM | Interpolation(USE_MARK) | /error(UnclosedInterpolation)   |return
    |c['}']                   | TERM | ->                              |>> :closing
    |default                  | ->                                     |>>

  |state[:closing]
    |c['}']                   | ->                                     |return  ; found }}
    |default                  | Interpolation(USE_MARK) | /error(UnclosedInterpolation) |return  ; only single }


; Inline raw !{:kind: content}
; sameline_raw - raw content inside !{:kind:...}
; Brace-counting for nested {} pairs (CORE "Inline Raw Content").
; Carries the block form's Raw marker; a single space after the label's
; closing `:` is a separator, not content (spec/TODO-SPEC-CORE.md, provisional
; for 0.8 — nailing tighter deferred past dialects/templating).
|function[sameline_raw:Directive]  | depth = 0
  |state[:kind]
    |c[':']                   | -> | Raw                         |>> :skip_sep
    |default                  | /name                            |>>  ; kind name

  ; Separator: one optional space after the closing `:` is not content.
  |state[:skip_sep]
    |c[' ']                   | ->                               |>> :content
    |default                  |                                  |>> :content

  |state[:content]
    | MARK                                                       |>> :scan

  |state[:scan]
    |c['{']                   | -> | depth += 1                  |>>  ; nested open
    |c['}']                   |                                  |>> :check_close
    |default                  | ->                               |>>

  |state[:check_close]
    |if[depth > 0]            | -> | depth -= 1                  |>> :scan  ; nested close
    |default                  | TERM | RawContent(USE_MARK) | -> |return    ; final close


; Regular inline directive !{name args}
|function[sameline_dir_body:Directive]
  |state[:name]
    |c[XLBL_START]                | /name                            |>> :after_name
    |default                  | /skip_brace_balanced             |return  ; malformed

  |state[:after_name]
    |c['}']                  | ->                               |return
    |c[' \t']                 | ->                               |>> :args
    |default                  | /skip_brace_balanced             |return

  ; The body of a non-raw inline directive is UDON (CORE "Dynamics": can
  ; contain |{...}, ;{...}, nested !{...}) — same content language as an
  ; embedded element, so it reuses /embed_content (which consumes the }).
  |state[:args]
    |c['}']                  | ->                               |return
    |default                  | /embed_content                   |return
