; Freeform blocks — the triple-backtick fence
;
; CORE spec area: "Triple-Backtick Escape (Freeform)" — exact-preservation
; body, opening at any head position, closing at any indentation.


; Freeform block - captures content until closing ``` at start of any line
; Preserves exact whitespace - no dedentation
; Closing ``` detected when line starts with optional whitespace then ```
; EXCEPTION to the auto-EOF convention (see 00-core): freeform's closer is the
; ` ``` ` fence LINE (a line-shape, not a byte), invisible to the classifier, so
; this function-level |eof is its explicit delimited declaration. (The eventual
; clean form is a `|unclosed Freeform` directive.) post_close keeps its own |eof
; too — the positional tail once the fence has closed (no warning).
|function[freeform:Freeform]
  |eof | Warning(UnclosedFreeform)                              |return
  ; Opening line: everything after the backticks begins the body (CORE
  ; "Triple-Backtick Escape" — an info string is just the body's first
  ; content; there is no separate info-string rule).
  |state[:opening]
    |c['\n']                  | ->                               |>> :line_start
    |default                  | MARK | ->['\n'] | -> | TERM | Text(USE_MARK) |>> :line_start  ; opening-line tail: terminator is text

  ; Start of each content line - MARK immediately, then check content
  ; Blank lines are content: freeform's contract is exact preservation
  ; (defect #15), so they emit BlankLine instead of vanishing.
  |state[:line_start]
    |c['\n']                  | MARK | -> | TERM | Text(USE_MARK) |>>  ; blank body line = Text "\n" (D2: exact mode)
    |default                  | MARK                             |>> :content

  ; Check if line is closing ``` (starts with optional ws then ```)
  ; A whitespace-only line is exact content: emit it as Text rather than
  ; letting its newline leak into the next line's Text (defect #15).
  |state[:content]
    |c[' \t']                 | ->                               |>>
    |c['\n']                  | -> | TERM | Text(USE_MARK)       |>> :line_start  ; ws-only line, terminator included
    |c['`']                   | ->                               |>> :maybe_end1
    |default                  | ->                               |>> :line

  |state[:line]
    | ->['\n'] | -> | TERM | Text(USE_MARK)                      |>> :line_start  ; terminator is text

  ; Check for ``` sequence
  |state[:maybe_end1]
    |c['`']                   | ->                               |>> :maybe_end2
    |default                  |                                  |>> :line  ; only one `, continue

  |state[:maybe_end2]
    |c['`']                   | ->                               |>> :post_close
    |default                  |                                  |>> :line  ; only ``, continue

  ; A closer must be followed by a newline; whitespace to the right of the
  ; backticks is ignored (CORE). Anything else means the line is body.
  |state[:post_close]
    |eof                      |                                  |return
    |c[' \t']                 | ->                               |>>
    |c['\n']                  | ->                               |return
    |default                  |                                  |>> :line
