; Dynamics — ! directives, raw blocks, interpolation
;
; CORE spec areas: "Dynamics (!)", "Code and Raw Content" (block !:lang:
; and inline !{:kind: ...}), "Unified Inline Syntax" (!{{expr}}
; interpolation, !{directive ...}). Meaning is a dialect's job; the core
; recognizes syntax and emits events.


; Block directive - !name or !:lang: for raw, or !{...} inline at document level
|function[block_directive:Directive]  :line_col  | raw_base = -1
  |state[:dispatch]
    |c[':']                   | ->                               |>> :raw_kind
    |c[XLBL_START]                | /name                            |>> :after_name
    |default                  |                                  |return  ; unreachable (callers guard)

  ; Raw block !:lang: - parse kind name
  |state[:raw_kind]
    |c[XLBL_START]                | /name | Raw                      |>> :raw_colon
    |default                  |                                  |return  ; malformed !:

  |state[:raw_colon]
    |c[':']                   | ->                               |>> :raw_eol
    |default                  |                                  |return  ; missing second :

  ; The body may begin on the directive line (CORE "Raw Directives", ruled
  ; 2026-07-16 — same shape as fences): whitespace after the label's closing
  ; ':' separates; the rest of the line is the first RawContent. A same-line
  ; tail does not establish the raw base (like sameline prose). Before this
  ; ruling the tail was consumed with no event — the keep-everything
  ; posture's one known violation.
  |state[:raw_eol]
    |c['\n']                  | ->                               |>> :raw_content
    |c[' \t']                 | ->                               |>>
    |default                  | MARK                             |>> :raw_sameline

  |state[:raw_sameline]
    |eof                      | TERM | RawContent(USE_MARK)      |return
    |c['\n']                  | TERM | RawContent(USE_MARK) | -> |>> :raw_content
    |default                  | ->                               |>>

  ; Raw content — captured at greater indent, dedented relative to the
  ; FIRST content line's column (raw_base); deeper lines keep their extra
  ; indent as content (CORE "Raw Directives": relative indent preserved).
  |state[:raw_content]
    |c['\n']                  | ->                               |>>
    |c[' ']                   | -> | col = 1                     |>> :raw_ws
    |default                  |                                  |return  ; non-indented, done

  |state[:raw_ws]
    |if[raw_base >= 0 && col >= raw_base]                        |>> :raw_at_base
    |c[' ']                   | -> | col += 1                    |>>
    |c['\n']                  | ->                               |>> :raw_content  ; ws-only line
    |default                  |                                  |>> :raw_checkbase

  |state[:raw_checkbase]
    |if[col <= :line_col]                                         |return  ; dedent
    |if[raw_base < 0]         | raw_base = col | MARK            |>> :raw_line
    |default                  | MARK                             |>> :raw_line  ; shallower than base: capture as-is

  |state[:raw_at_base]
    |default                  | MARK                             |>> :raw_line  ; extra spaces beyond base are content

  |state[:raw_line]
    |eof                      | TERM | RawContent(USE_MARK)      |return
    |c['\n']                  | TERM | RawContent(USE_MARK) | -> |>> :raw_content
    |default                  | ->                               |>>

  ; Regular directive - parse condition/args and children
  |state[:after_name]
    |c['\n']                  | ->                               |>> :children
    |c[' \t']                 | ->                               |>> :condition
    |default                  |                                  |>> :children

  |state[:condition]
    |c['\n']                  | ->                               |>> :children
    |default                  | MARK | /directive_args           |>> :children

  ; Children at greater indent
  |state[:children]
    |c['\n']                  | ->                               |>>
    |c[' ']                   | col = /count_indent              |>> :check_child
    |c['\t']                  | /error(NoTabs) | ->['\n'] | ->       |>>
    |default                  | col = COL - 1                    |>> :check_child

  |state[:check_child]
    |if[col <= :line_col]                                         |return
    |                                                            |>> :child_dispatch

  |state[:child_dispatch]
    |c['|']                   | ->                               |>> :child_pipe
    |c[':']                   | ->                               |>> :child_check_attr
    |c['!']                   | ->                               |>> :dchild_check_bang
    |c[';']                   | -> | /line_comment               |>> :children
    |c[<BS>]                  | -> | /verbatim_text              |>> :children
    |default                  | /prose(col, :line_col, <>)       |>> :children

  ; `!` guard in directive children (see document :check_bang)
  |state[:dchild_check_bang]
    |c[':']                   | /block_directive(col)            |>> :children
    |c[XLBL_START]            | /block_directive(col)            |>> :children
    |c['{']                   | -> | /sameline_directive         |>> :children
    |default                  | /prose(col, :line_col, '!')      |>> :children

  ; Line-initial attr guard (see document :check_attr): failed attr parse
  ; falls back to intact prose with the ':' restored (defect #12).
  |state[:child_check_attr]
    |c[<XLBL_START SQ>]       | dstate = /block_attr             |>> :dattr_check
    |default                  | /prose(col, :line_col, ':')      |>> :children

  |state[:dattr_check]
    |if[dstate == 1]          | /error(missing_attribute_value) | Nil |>> :children
    |default                  |                                  |>> :children

  |state[:child_pipe]
    |c['{']                   | -> | /embedded                   |>> :children
    |c[<XLBL_START SQ '[' '.?!*+'>] | /element(col, :line_col)         |>> :children
    |default                  | /prose(col, :line_col, '|')      |>> :children


; Directive arguments - capture until newline or EOF
|function[directive_args:Text]  | ->['\n'] | TERM


; Inline dynamics - dispatch based on first char after {
; Called with position at first char inside braces.
; EOF or EOL here means the line ended right after `!{` — a NAMELESS opener.
; Ruled (CHANGELOG alpha.2): no valid directive ever started, so the consumed
; bytes are restored as prose Text "!{" (parallel to the bare-marker family;
; EOF ≡ eol per the same ledger, so the newline twin matches). Intercepted
; BEFORE /sameline_dir_body, whose BRACKET entry would emit DirectiveStart;
; the newline is left unconsumed for the caller's line handling.
|function[sameline_directive]
  |state[:dispatch]
    |eof                      | MARK | PREPEND('\x21\x7b') | TERM | Text(USE_MARK) |return
    |c['\n']                  | MARK | PREPEND('\x21\x7b') | TERM | Text(USE_MARK) |return
    |c['{']                   | -> | /interpolation              |return  ; !{{expr}}
    |c[':']                   | -> | /sameline_raw                 |return  ; !{:kind: content}
    |default                  | /sameline_dir_body                 |return  ; !{name args}


; Interpolation !{{expr}} - double-brace, must close with }} (matched across
; :main → :closing). (Delimited; EOF auto-handled.) No TERM is issued until
; the closer is CONFIRMED: a lone consumed '}' stays inside the accumulation,
; so the generated EOF force-unwind keeps it as content — `!{{a}`<EOF> emits
; "a}" (keep-everything; the gap-4 partial-closer case), while a clean `}}`
; close excludes both closer bytes via TERM(-1) before consuming the second.
|function[interpolation:Interpolation]  | MARK
  |state[:main]
    |c['}']                   | ->                                     |>> :closing
    |default                  | ->                                     |>>

  ; First-}} rule (resolved 2026-07-16): a single '}' is expression content;
  ; only '}}' terminates.
  |state[:closing]
    |c['}']                   | TERM(-1) | ->                          |return  ; found }}
    |default                  | ->                                     |>> :main


; Inline raw !{:kind: content} — the Directive wrapper: emit Raw + the kind
; name, then delegate the brace-balanced body to /sameline_raw_body. A single
; space after the label's closing `:` is a separator, not content
; (spec/TODO-SPEC-CORE.md, provisional for 0.8 — tighter nailing deferred past
; dialects/templating).
|function[sameline_raw:Directive]
  |state[:kind]
    |c[':']                   | -> | Raw                         |>> :skip_sep
    |default                  | /name                            |>>  ; kind name

  ; Separator: one optional space after the closing `:` is not content.
  |state[:skip_sep]
    |c[' ']                   | -> | /sameline_raw_body          |return
    |default                  | /sameline_raw_body               |return

; The inline-raw BODY: brace-balanced verbatim content, closer `}` (CORE
; "Inline Raw Content"; nested {} pairs are balanced content). Its OWN delimited
; construct (CONTENT/RawContent) so the generated EOF force-unwind keeps the
; body (RawContent) AND — via `|unclosed InlineRaw` — names its warning
; UnclosedInlineRaw, not the Directive return type of the wrapper. Mirrors the
; embedded / embed_content split.
|function[sameline_raw_body:RawContent]  | depth = 0
  |unclosed InlineRaw
  |state[:scan]
    |c['{']                   | -> | depth += 1                  |>>  ; nested open
    |c['}']                   |                                  |>> :check_close
    |default                  | ->                               |>>

  |state[:check_close]
    |if[depth > 0]            | -> | depth -= 1                  |>> :scan  ; nested close
    |default                  | TERM | ->                        |return    ; RawContent auto-emitted on return


; Regular inline directive !{name args}
|function[sameline_dir_body:Directive]
  |unclosed InlineDirective
  |state[:name]
    |c[XLBL_START]                | /name                            |>> :after_name
    |default                  | /skip_brace_balanced             |return  ; malformed

  ; `!{name`<EOF> — a named inline directive whose `}` never arrives. descent
  ; generates a state's EOF handler from its `default` arm; here that default is
  ; `/skip_brace_balanced` (silent), so without this arm the unclosed directive
  ; returned with no warning (only the `:args` path warns, via embed_content's
  ; own eof). Explicit EOF arm keeps the already-emitted name and warns, mirroring
  ; freeform's `|eof | Warning(UnclosedFreeform)`. (The NAMELESS `!{`<EOF> is
  ; intercepted BEFORE this function ever runs — sameline_directive's :dispatch
  ; eof arm restores the consumed bytes as prose Text "!{", per the ruling.)
  |state[:after_name]
    |eof                      | Warning(UnclosedInlineDirective) |return
    |c['}']                  | ->                               |return
    |c[' \t']                 | ->                               |>> :args
    |default                  | /skip_brace_balanced             |return

  ; The body of a non-raw inline directive is UDON (CORE "Dynamics": can
  ; contain |{...}, ;{...}, nested !{...}) — same content language as an
  ; embedded element, so it reuses /embed_content (which consumes the }).
  |state[:args]
    |c['}']                  | ->                               |return
    |default                  | /embed_content('UnclosedInlineDirective') |return
