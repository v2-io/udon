; UDON Value Type Parser Functions
;
; This file provides typed value parsing for UDON. It is concatenated
; with udon.desc during parser generation.
;
; CONCATENATED WITH:
;   udon.desc - Main UDON grammar (provides type declarations, entry point)
;
; GENERATION:
;   ./regenerate-parser  # concatenates *.desc files and runs descent
;
; PROVIDES:
;   /typed_value(:space_term, :bracket) - Main entry point
;     :space_term = 0 (attr value: bare-token BOUNDARY rule applies) or
;                   1 (array item / [key]: space simply terminates)
;     :bracket = 0 (none), } (embedded), or ] (array)
;
; EMITS:
;   BoolTrue   - true
;   BoolFalse  - false
;   Nil        - null, nil
;   Integer    - decimal, hex (0x), octal (0o), binary (0b)
;   Float      - with decimal point or exponent
;   Rational   - integer/integer + r (e.g., 1/3r)  [provisional, CORE "Numbers"]
;   Complex    - number +/- number + i (e.g., 3+4i, 5i)  [provisional]
;   BareValue  - single-token bare string
;   Text       - text blob (0.9: bare token + plain text at the boundary)
;   Reference  - @... in value position
;
; THE 0.9 BOUNDARY MODEL (CORE "The Scan and the Bare-Token Boundary"):
; self-terminating shapes (numbers, quotes, <...>, [...], @refs) end at
; space in every mode. Only the keyword/bare-string paths hold the scan
; provisionally open at a space: the next non-space character decides —
; a head-position marker (or EOL/bracket) finishes the single-token value;
; plain text commits the REST OF THE LINE to a Text blob (owned by the
; attribute — ownership is the caller's context). A framed ' ; ' inside a
; blob opens a comment. KNOWN GAPS (staged): inline forms inside blobs
; (|{...} etc.) are literal content for now — segmentation needs the
; re-emittable-key machinery (see TODO-CORE-PARSING).
;
; TEMPORAL IS GONE FROM BARE RECOGNITION (CORE 0.8): a bare 2026-07-11 is
; the string "2026-07-11"; temporal lives in the <...> envelope, resolved by
; the future temporal@1 dialect. The working recognition logic is preserved
; in temporal-value.desc.setaside (NOT concatenated) for that dialect to
; re-home. Cut 2026-07-15; the last living version is at tag grammar-v0.7.

; ============================================================================
; Keyword Lookup (phf perfect hash)
; ============================================================================

; O(1) keyword lookup for boolean/nil literals
|keywords[bare_kw] :fallback /emit_bare_value
  | true   => BoolTrue
  | false  => BoolFalse
  | null   => Nil
  | nil    => Nil

; Fallback: emit accumulated content as BareValue
; MUST be void - uses caller's MARK, not its own
|function[emit_bare_value]
  |state[:main]
    |eof                      | BareValue(USE_MARK)              |return
    |default                  | BareValue(USE_MARK)              |return

; ============================================================================
; Main Entry - Context-Aware Value Parser
; ============================================================================

|function[typed_value]  :space_term :bracket  | MARK | depth = 0
  |state[:main]
    |eof                      | BareValue(USE_MARK)              |return
    |c['\n']                  | BareValue(USE_MARK)              |return
    |c[' ']                   | BareValue(USE_MARK)              |return
    |c[:bracket]              | BareValue(USE_MARK)              |return
    |c['<']                   | -> | depth += 1                  |>> :envelope
    |c['@']                   | ->                               |>> :maybe_ref
    |c['0']                   | ->                               |>> :num_zero
    |c['123456789']           |                                  |>> :num_dec
    |c['+-']                  | ->                               |>> :num_sign
    |LETTER                   | ->                               |>> :accumulate
    |default                  | ->                               |>> :string

  ; === Explicit-typing envelope <...> (CORE "Explicit Typing") ===
  ; INTERIM: recognized (<>-balanced, single-line) but Warning + string
  ; pass-through until the dialect layer lands. A newline before the
  ; matching '>' is UnclosedTypeEnvelope (CORE: envelopes are single-line).
  |state[:envelope]
    |eof                      | Warning(UnclosedTypeEnvelope) | BareValue(USE_MARK) |return
    |c['\n']                  | TERM | Warning(UnclosedTypeEnvelope) | BareValue(USE_MARK) |return
    |c['<']                   | -> | depth += 1                  |>>
    |c['>']                   | -> | depth -= 1                  |>> :env_check
    |default                  | ->                               |>>

  |state[:env_check]
    |if[depth == 0]           | TERM | Warning(NoDialectsLoaded) | BareValue(USE_MARK) |return
    |default                  |                                  |>> :envelope

  ; === Reference in value position (CORE "References", 0.9 guard) ===
  ; Guard: `@` + `[`, `.`, or identifier. Payload is the raw text after `@`
  ; (brackets and trait tails included) — same convention as /block_ref in
  ; udon.desc (`@el[key].trait` is one payload "el[key].trait").
  |state[:maybe_ref]
    |c[<L>]                   | MARK | ->[']'] | ->              |>> :ref_tail
    |c[<XLBL_START '.'>]      | MARK | ->                        |>> :ref_ident
    |default                  |                                  |>> :string

  |state[:ref_ident]
    |eof                      | TERM | Reference(USE_MARK)       |return
    |c[<XLBL_CONT '.'>]       | ->                               |>>
    |c[<L>]                   | ->[']'] | ->                     |>> :ref_tail
    |default                  | TERM | Reference(USE_MARK)       |return

  ; After `[key]`: trait selectors may still follow (`@el[key].trait`)
  |state[:ref_tail]
    |eof                      | TERM | Reference(USE_MARK)       |return
    |c[<XLBL_CONT '.'>]       | ->                               |>>
    |default                  | TERM | Reference(USE_MARK)       |return

  ; === Accumulate identifier for keyword lookup ===
  ; If we see non-label chars (like .), it's not a keyword - continue as string
  |state[:accumulate]
    |eof                      | TERM | KEYWORDS(bare_kw)         |return
    |c['\n']                  | TERM | KEYWORDS(bare_kw)         |return
    |c[' ']                   |                                  |>> :accum_space
    |c[:bracket]              | TERM | KEYWORDS(bare_kw)         |return
    |LABEL_CONT               | ->                               |>>
    |default                  | ->                               |>> :string
  |state[:accum_space]
    |if[space_term == 1]      | TERM | KEYWORDS(bare_kw)         |return
    |default                  | TERM                             |>> :kw_boundary

  ; Keyword-path boundary: consume spaces; a marker/EOL finishes the lone
  ; token (typed if keyword); plain text commits the blob.
  |state[:kw_boundary]
    |eof                      | KEYWORDS(bare_kw)                |return
    |c[' \t']                 | ->                               |>>
    |c['\n']                  | KEYWORDS(bare_kw)                |return
    |c[:bracket]              | KEYWORDS(bare_kw)                |return
    |c[<':;!@`' P BS>]        | KEYWORDS(bare_kw)                |return
    |default                  |                                  |>> :blob

  ; === Numbers: after sign (+/-) ===
  |state[:num_sign]
    |c['0']                   | ->                               |>> :num_zero
    |c['123456789']           |                                  |>> :num_dec
    |default                  |                                  |>> :accumulate

  ; === Numbers (self-terminating: space ends them in every mode) ===
  |state[:num_zero]
    |eof                      | Integer(USE_MARK)                |return
    |c['xX']                  | ->                               |>> :num_hex
    |c['oO']                  | ->                               |>> :num_oct
    |c['bB']                  | ->                               |>> :num_bin
    |c['dD']                  | ->                               |>> :num_dec   ; 0d42 explicit decimal (CORE "Numbers")
    |c['.']                   | ->                               |>> :num_float_frac
    |c['eE']                  | ->                               |>> :num_float_exp
    |c[<0-9 '_'>]              | ->                               |>> :num_dec
    |c['\n']                  | Integer(USE_MARK)                |return
    |c[' ']                   | Integer(USE_MARK)                |return
    |c[:bracket]              | Integer(USE_MARK)                |return
    |default                  |                                  |>> :string

  |state[:num_dec]
    |eof                      | Integer(USE_MARK)                |return
    |c[<0-9 '_'>]             | ->                               |>>
    |c['.']                   | ->                               |>> :num_float_frac
    |c['eE']                  | ->                               |>> :num_float_exp
    |c['/']                   | ->                               |>> :num_rational_denom
    |c['i']                   | -> | Complex(USE_MARK)           |return
    |c['+-']                  | ->                               |>> :num_complex_sign
    |c['\n']                  | Integer(USE_MARK)                |return
    |c[' ']                   | Integer(USE_MARK)                |return
    |c[:bracket]              | Integer(USE_MARK)                |return
    |default                  |                                  |>> :string

  |state[:num_hex]
    |eof                      | Integer(USE_MARK)                |return
    |c[<0-9 a-f A-F '_'>]     | ->                               |>>
    |c['\n']                  | Integer(USE_MARK)                |return
    |c[' ']                   | Integer(USE_MARK)                |return
    |c[:bracket]              | Integer(USE_MARK)                |return
    |default                  |                                  |>> :string

  |state[:num_oct]
    |eof                      | Integer(USE_MARK)                |return
    |c[<0-7 '_'>]              | ->                               |>>
    |c['\n']                  | Integer(USE_MARK)                |return
    |c[' ']                   | Integer(USE_MARK)                |return
    |c[:bracket]              | Integer(USE_MARK)                |return
    |default                  |                                  |>> :string

  |state[:num_bin]
    |eof                      | Integer(USE_MARK)                |return
    |c[<0-1 '_'>]              | ->                               |>>
    |c['\n']                  | Integer(USE_MARK)                |return
    |c[' ']                   | Integer(USE_MARK)                |return
    |c[:bracket]              | Integer(USE_MARK)                |return
    |default                  |                                  |>> :string

  |state[:num_float_frac]
    |eof                      | Float(USE_MARK)                  |return
    |c[<0-9 '_'>]             | ->                               |>>
    |c['eE']                  | ->                               |>> :num_float_exp
    |c['i']                   | -> | Complex(USE_MARK)           |return
    |c['+-']                  | ->                               |>> :num_complex_sign
    |c['\n']                  | Float(USE_MARK)                  |return
    |c[' ']                   | Float(USE_MARK)                  |return
    |c[:bracket]              | Float(USE_MARK)                  |return
    |default                  |                                  |>> :string

  |state[:num_float_exp]
    |eof                      | Float(USE_MARK)                  |return
    |c['+-']                  | ->                               |>> :num_float_exp_digits
    |c[<0-9>]                  |                                  |>> :num_float_exp_digits
    |c['\n']                  | Float(USE_MARK)                  |return
    |c[' ']                   | Float(USE_MARK)                  |return
    |c[:bracket]              | Float(USE_MARK)                  |return
    |default                  |                                  |>> :string

  |state[:num_float_exp_digits]
    |eof                      | Float(USE_MARK)                  |return
    |c[<0-9 '_'>]             | ->                               |>>
    |c['i']                   | -> | Complex(USE_MARK)           |return
    |c['+-']                  | ->                               |>> :num_complex_sign
    |c['\n']                  | Float(USE_MARK)                  |return
    |c[' ']                   | Float(USE_MARK)                  |return
    |c[:bracket]              | Float(USE_MARK)                  |return
    |default                  |                                  |>> :string

  ; === Rational: integer/integer + r (e.g., 1/3r) — provisional ===
  |state[:num_rational_denom]
    |eof                      | BareValue(USE_MARK)              |return
    |c[<0-9 '_'>]             | ->                               |>>
    |c['r']                   | -> | Rational(USE_MARK)          |return
    |c['\n']                  | BareValue(USE_MARK)              |return
    |c[' ']                   | BareValue(USE_MARK)              |return
    |c[:bracket]              | BareValue(USE_MARK)              |return
    |default                  |                                  |>> :string

  ; === Complex: number +/- number + i (e.g., 3+4i) — provisional ===
  |state[:num_complex_sign]
    |c[<0-9>]                 |                                  |>> :num_complex_imag
    |default                  |                                  |>> :string
  |state[:num_complex_imag]
    |eof                      | BareValue(USE_MARK)              |return
    |c[<0-9 '_'>]             | ->                               |>>
    |c['.']                   | ->                               |>> :num_complex_imag_frac
    |c['eE']                  | ->                               |>> :num_complex_imag_exp
    |c['i']                   | -> | Complex(USE_MARK)           |return
    |c['\n']                  | BareValue(USE_MARK)              |return
    |c[' ']                   | BareValue(USE_MARK)              |return
    |c[:bracket]              | BareValue(USE_MARK)              |return
    |default                  |                                  |>> :string
  |state[:num_complex_imag_frac]
    |eof                      | BareValue(USE_MARK)              |return
    |c[<0-9 '_'>]             | ->                               |>>
    |c['eE']                  | ->                               |>> :num_complex_imag_exp
    |c['i']                   | -> | Complex(USE_MARK)           |return
    |c['\n']                  | BareValue(USE_MARK)              |return
    |c[' ']                   | BareValue(USE_MARK)              |return
    |c[:bracket]              | BareValue(USE_MARK)              |return
    |default                  |                                  |>> :string
  |state[:num_complex_imag_exp]
    |eof                      | BareValue(USE_MARK)              |return
    |c['+-']                  | ->                               |>> :num_complex_imag_exp_d
    |c[<0-9>]                 |                                  |>> :num_complex_imag_exp_d
    |c['\n']                  | BareValue(USE_MARK)              |return
    |c[' ']                   | BareValue(USE_MARK)              |return
    |c[:bracket]              | BareValue(USE_MARK)              |return
    |default                  |                                  |>> :string
  |state[:num_complex_imag_exp_d]
    |eof                      | BareValue(USE_MARK)              |return
    |c[<0-9 '_'>]             | ->                               |>>
    |c['i']                   | -> | Complex(USE_MARK)           |return
    |c['\n']                  | BareValue(USE_MARK)              |return
    |c[' ']                   | BareValue(USE_MARK)              |return
    |c[:bracket]              | BareValue(USE_MARK)              |return
    |default                  |                                  |>> :string

  ; === Bare string (anything not keyword/number) ===
  |state[:string]
    |eof                      | BareValue(USE_MARK)              |return
    |c['\n']                  | BareValue(USE_MARK)              |return
    |c[' ']                   |                                  |>> :string_space
    |c[:bracket]              | BareValue(USE_MARK)              |return
    |default                  | ->                               |>>
  |state[:string_space]
    |if[space_term == 1]      | BareValue(USE_MARK)              |return
    |default                  | TERM                             |>> :str_boundary

  ; Bare-string boundary: same shape as the keyword boundary.
  |state[:str_boundary]
    |eof                      | BareValue(USE_MARK)              |return
    |c[' \t']                 | ->                               |>>
    |c['\n']                  | BareValue(USE_MARK)              |return
    |c[:bracket]              | BareValue(USE_MARK)              |return
    |c[<':;!@`' P BS>]        | BareValue(USE_MARK)              |return
    |default                  |                                  |>> :blob

  ; === Text blob (0.9): the line committed — runs to EOL / bracket, with
  ; the framed ' ; ' comment carve-out. Re-TERMs over the boundary TERM so
  ; the emitted Text spans from the original MARK. ===
  |state[:blob]
    |eof                      | TERM | Text(USE_MARK)            |return
    |c['\n']                  | TERM | Text(USE_MARK)            |return
    |c['{']                   | -> | depth += 1                  |>>
    |c[:bracket]              |                                  |>> :blob_close
    |c[';']                   |                                  |>> :blob_semi
    |default                  | ->                               |>>

  ; In embedded context the blob is brace-balanced: a nested {...} pair is
  ; content; only the element's own closer ends the blob. (Interim: inline
  ; forms inside blobs are literal content until segment re-emission lands.)
  |state[:blob_close]
    |if[depth > 0]            | -> | depth -= 1                  |>> :blob
    |default                  | TERM | Text(USE_MARK)            |return

  ; Framed ' ; ' check (mirror of sameline_text): space before (PREV) and
  ; space/EOL after open a comment; anything else keeps the ';' literal.
  |state[:blob_semi]
    |if[PREV == ' ']          | ->                               |>> :blob_semi_after
    |default                  | ->                               |>> :blob

  |state[:blob_semi_after]
    |eof                      | TERM(-2) | Text(USE_MARK) | /line_comment_content |return
    |c[' ']                   | TERM(-2) | Text(USE_MARK) | /line_comment_content |return
    |c['\n']                  | TERM(-2) | Text(USE_MARK) | /line_comment_content |return
    |default                  |                                  |>> :blob
