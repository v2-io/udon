#!/usr/bin/env bash
#
# regenerate-parser - Regenerate the UDON parser from the grammar units
# (generator/NN-udon.*.descent.udon — the descent DSL, each a valid UDON doc)
#
# Concatenates the grammar files in order, runs descent, and builds.
#
# Usage:
#   ./regenerate-parser           # Update descent, generate parser, and build
#   ./regenerate-parser --trace   # Generate with tracing (for debugging)
#   ./regenerate-parser --no-build # Generate parser only (no cargo build)
#   ./regenerate-parser --check    # Check descent availability only

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GENERATOR_DIR="$SCRIPT_DIR/generator"
OUTPUT_FILE="$SCRIPT_DIR/udon-core/src/parser.rs"

# Default descent location - check common places
# Prefer the umbrella's pinned submodule (../tools/descent); fall back to a
# sibling checkout; DESCENT_DIR env always wins.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${DESCENT_DIR:-}" ] && [ -f "$SCRIPT_DIR/../tools/descent/descent.gemspec" ]; then
  DESCENT_DIR="$SCRIPT_DIR/../tools/descent"
fi
DESCENT_DIR="${DESCENT_DIR:-$HOME/src/descent}"

# Colors for output (if terminal supports it)
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    NC='\033[0m' # No Color
else
    RED='' GREEN='' YELLOW='' BLUE='' NC=''
fi

info() { echo -e "${BLUE}==>${NC} $*"; }
success() { echo -e "${GREEN}==>${NC} $*"; }
warn() { echo -e "${YELLOW}warning:${NC} $*"; }
error() { echo -e "${RED}error:${NC} $*" >&2; }

# Check if descent is available (the Rust workspace is the toolchain)
check_descent() {
    if [[ ! -d "$DESCENT_DIR/rust" ]]; then
        error "descent (rust workspace) not found at $DESCENT_DIR/rust"
        echo ""
        echo "From the umbrella repo:  git submodule update --init tools/descent"
        echo "Or set DESCENT_DIR to a descent checkout."
        return 1
    fi
    return 0
}

# Show which descent we're generating with
describe_descent() {
    local git_info=""
    if [[ -e "$DESCENT_DIR/.git" ]]; then
        git_info=$(cd "$DESCENT_DIR" && git rev-parse --short HEAD 2>/dev/null || echo "")
        [[ -n "$git_info" ]] && git_info=" @ ${git_info}"
    fi
    success "descent${git_info} at $DESCENT_DIR"
}

# Generate the parser
# Args: $1 = "true" for trace mode, "false" otherwise
generate_parser() {
    local trace_mode="${1:-false}"

    info "Concatenating grammar files..."

    # Topical grammar units, concatenated in order (descent sees ONE unit —
    # cross-file function references are free; order is for the reader).
    # 00 must lead: it holds the |parser/|type/|const/|entry-point
    # declarations. Explicit list (not a glob) on purpose: the generator dir
    # also holds set-aside grammars (udon-legacy-pre-0.8.descent.udon,
    # temporal-value.desc.setaside) that a glob would silently ingest; a
    # forgotten entry fails loudly below instead.
    local desc_files=(
        "$GENERATOR_DIR/00-udon.core.descent.udon"
        "$GENERATOR_DIR/10-udon.elements.descent.udon"
        "$GENERATOR_DIR/20-udon.attributes.descent.udon"
        "$GENERATOR_DIR/30-udon.values.descent.udon"
        "$GENERATOR_DIR/40-udon.prose.descent.udon"
        "$GENERATOR_DIR/50-udon.comments.descent.udon"
        "$GENERATOR_DIR/60-udon.embedded.descent.udon"
        "$GENERATOR_DIR/70-udon.dynamics.descent.udon"
        "$GENERATOR_DIR/80-udon.freeform.descent.udon"
        "$GENERATOR_DIR/90-udon.references.descent.udon"
    )

    for f in "${desc_files[@]}"; do
        if [[ ! -f "$f" ]]; then
            error "Missing: $f"
            return 1
        fi
    done

    # Create temp file for concatenated input
    local tmp_file
    tmp_file=$(mktemp "${TMPDIR:-/tmp}/udon-combined.XXXXXX.desc")
    trap "rm -f '$tmp_file'" EXIT

    cat "${desc_files[@]}" > "$tmp_file"

    local descent_args="generate"
    if [[ "$trace_mode" == "true" ]]; then
        descent_args="generate --trace"
        info "Running descent with tracing..."
    else
        info "Running descent..."
    fi

    # Generate through descent-rs. Write ATOMICALLY: generate to a temp
    # file, move into place only on success — a truncate-first redirect once
    # destroyed parser.rs.
    local out_tmp trace_flag descent_rs
    out_tmp=$(mktemp "${TMPDIR:-/tmp}/udon-parser.XXXXXX.rs")
    trace_flag=""; [[ "$trace_mode" == "true" ]] && trace_flag="--trace"
    descent_rs="$DESCENT_DIR/rust/target/release/descent-rs"
    # ALWAYS (re)build — cargo is a fast no-op when up-to-date but rebuilds when
    # the descent source changed. Guarding on the binary merely EXISTING (the old
    # `! -x` check) silently reused a STALE descent-rs after a `tools/descent`
    # submodule bump → a wrong parser.rs with spurious gate reds that look like a
    # broken merge. (Bit us 2026-07-18; see the EOF-generation landing.)
    info "Building descent-rs..."
    (cd "$DESCENT_DIR/rust" && cargo build --release -p descent-cli) || {
        rm -f "$out_tmp"
        error "descent-rs build failed"
        return 1
    }
    if [[ ! -x "$descent_rs" ]]; then
        rm -f "$out_tmp"
        error "descent-rs binary not found at $descent_rs after build"
        return 1
    fi
    if "$descent_rs" generate "$tmp_file" $trace_flag > "$out_tmp"; then
        mv "$out_tmp" "$OUTPUT_FILE"
        success "Generated $OUTPUT_FILE"
    else
        rm -f "$out_tmp"
        error "descent-rs failed (parser.rs left untouched)"
        return 1
    fi

    # Pushdown (explicit-stack, resumable) sibling — same grammar, same
    # atomic-write discipline. No trace variant (v1 limit).
    local pd_out pd_tmp
    pd_out="$SCRIPT_DIR/udon-core/src/parser_pd.rs"
    pd_tmp=$(mktemp "${TMPDIR:-/tmp}/udon-parser-pd.XXXXXX.rs")
    if "$descent_rs" generate "$tmp_file" --backend pushdown > "$pd_tmp"; then
        mv "$pd_tmp" "$pd_out"
        success "Generated $pd_out"
    else
        rm -f "$pd_tmp"
        error "descent-rs pushdown backend failed (parser_pd.rs left untouched)"
        return 1
    fi
}

# Build with cargo
build_project() {
    info "Building with cargo..."
    cd "$SCRIPT_DIR"
    cargo build 2>&1 | grep -v "^warning:" | head -20 || true

    if cargo build 2>/dev/null; then
        success "Build complete"
    else
        warn "Build had warnings (run 'cargo build' for details)"
    fi
}

# Main
main() {
    local no_build=false
    local check_only=false
    local trace=false

    for arg in "$@"; do
        case "$arg" in
            --no-build) no_build=true ;;
            --check) check_only=true ;;
            --trace) trace=true; no_build=true ;;
            --help|-h)
                echo "Usage: $0 [--trace] [--no-build] [--check]"
                echo ""
                echo "Options:"
                echo "  --trace     Generate with tracing enabled (implies --no-build)"
                echo "  --no-build  Generate parser but don't run cargo build"
                echo "  --check     Only check if descent is available"
                echo ""
                echo "Environment:"
                echo "  DESCENT_DIR  Path to descent (default: ~/src/descent)"
                exit 0
                ;;
            *)
                error "Unknown option: $arg"
                exit 1
                ;;
        esac
    done

    if ! check_descent; then
        exit 1
    fi

    if $check_only; then
        exit 0
    fi

    describe_descent

    if ! generate_parser "$trace"; then
        exit 1
    fi

    if ! $no_build; then
        build_project
    fi
}

main "$@"
