  <source media=\"(prefers-color-scheme: light)\" srcset=\"logo-light.png\">\n  <img src=\"logo-light.png\" alt=\"Company logo\">\n</picture>\n```\n\nIf you prefer CSS, you can swap the images with two `<img>` tags:\n\n```html\n<img class=\"logo logo-light\" src=\"logo-light.png\" alt=\"Company logo\">\n<img class=\"logo logo-dark\" src=\"logo-dark.png\" alt=\"Company logo\">\n\n<style>\n  .logo-dark { display: none; }\n\n  @media (prefers-color-scheme: dark) {\n    .logo-light { display: none; }\n    .logo-dark { display: inline; }\n  }\n</style>\n```\n\nBoth approaches follow the operating system or browser setting. The `<picture>` version is simpler and loads only the image that's needed. The CSS version is useful if you also want to switch the logo based on a site-level theme toggle, which would require using a `data-theme` attribute instead of the media query."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":576,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":576},"output_tokens":6,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"bf7a3190-eaf6-49a8-85d0-1a5d39c002a8","uuid":"8a001a46-a5ce-4ed8-8caf-536184893d83","timestamp":"2026-10-15T15:06:19.911Z","request_id":"req_011Cg4EKHYHeHWjDThSuiwrC"},{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","resetsAt":1792093800,"rateLimitType":"five_hour","overageStatus":"rejected","overageDisabledReason":"out_of_credits","isUsingOverage":false,"unifiedWindows":{"five_hour":{"utilization":0.01,"resetsAt":1792093800},"seven_day":{"utilization":0.07,"resetsAt":1792501200}}},"uuid":"114d26e8-219c-4a71-8c7d-89240f6de6af","session_id":"bf7a3190-eaf6-49a8-85d0-1a5d39c002a8"},{"duration_api_ms":3293,"stop_reason":"end_turn","session_id":"bf7a3190-eaf6-49a8-85d0-