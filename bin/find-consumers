#!/usr/bin/env bash
# find-consumers — scan for live .udon documents outside this repo.
#
# Usage:
#   bin/find-consumers            # inventory + exposure profile
#   bin/find-consumers --check    # also parse each (needs core/ built:
#                                 #   cd core && cargo build --release --example stdin_parse)
#
# Pairs with CONSUMERS.md (the curated registry). When a spec release lands
# or a parser change ships, run this, diff against the registry table, and
# notify/migrate. See CONSUMERS.md "Notification triggers". For *meaning*
# changes (not just errors/warnings), the registry documents the stronger
# differential method: build the previous release's parser from its tag and
# diff full event streams per document.
#
# Exposure columns (grep approximations; the parser is the real measure).
# Structure-shaped counts are anchored to lines that *start* with markup
# (`|` or `:` after indent) so prose/comment mentions of syntax don't count
# — these docs discuss UDON syntax in prose (tightened 2026-07-16 after the
# unanchored counts picked up backtick-quoted conventions in comments):
#   keys       |el[key] identity sites
#   refs       @-reference sites
#   suffixes   element suffix flags (|el?, |el[k]?, ...)
#   flags      0.9 attribute flags (:key?)
#   attr-dates bare date-shaped attribute values (:k 2026-07-16 — plain
#              strings since core 0.8; the temporal-dialect migration surface)
#   envelopes  <...> typed-value envelopes in value position (NoDialectsLoaded
#              until the dialect layer lands)
#   inline     |{...} embedded elements
#   fences     ``` freeform fences

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
PARSER="$REPO_DIR/core/target/release/examples/stdin_parse"
CHECK="${1:-}"

# Scan roots: arch explicitly (the ARCHEMA program, primary consumer), then a
# depth-limited sweep of ~/src for strays. Excludes this repo, _ref, and
# .claude/worktrees (agent worktree copies shadow their originals).
FILES=$( {
  find "$HOME/src/arch" -name '*.udon' -not -path '*/.git/*' \
    -not -path '*/.claude/worktrees/*' 2>/dev/null
  find "$HOME/src" -maxdepth 4 -name '*.udon' \
    -not -path "$REPO_DIR/*" \
    -not -path "$HOME/src/_ref/*" \
    -not -path "$HOME/src/arch/*" \
    -not -path '*/.claude/worktrees/*' \
    -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/target/*' 2>/dev/null
} | sort -u )

[ -z "$FILES" ] && { echo "No consumer .udon files found."; exit 0; }

count() { grep -oE "$1" "$2" | wc -l | tr -d ' ' || true; }
# Occurrences of $1 on markup-rooted lines (indent + `|` or `:`) only:
mcount() { grep -E '^[[:space:]]*[|:]' "$2" | grep -oE "$1" | wc -l | tr -d ' ' || true; }

printf '%s\n' "$FILES" | while read -r f; do
  rel="${f/#$HOME\/src\//}"
  lines=$(wc -l < "$f" | tr -d ' ')
  keys=$(count '^[[:space:]]*\|[a-zA-Z-]*\[[^]]+\]' "$f")
  refs=$(mcount '@\[|@[a-z]+\[' "$f")
  sfx=$(count '^[[:space:]]*\|[a-zA-Z-]*(\[[^]]+\])?[?!*+]' "$f")
  flags=$(mcount ':[a-zA-Z][a-zA-Z0-9/-]*\?([[:space:]]|$)' "$f")
  dates=$(mcount ':[a-z-]+ +20[0-9]{2}-[0-9]{2}-[0-9]{2}' "$f")
  env=$(mcount ':[a-z-]+ +<' "$f")
  inline=$(mcount '\|\{' "$f")
  fences=$(count '^[[:space:]]*```' "$f")
  echo "$rel  (${lines}L)  keys=$keys refs=$refs suffixes=$sfx flags=$flags attr-dates=$dates envelopes=$env inline=$inline fences=$fences"
  if [ "$CHECK" = "--check" ]; then
    if [ ! -x "$PARSER" ]; then
      echo "  --check: parser not built (cd core && cargo build --release --example stdin_parse)"; exit 1
    fi
    ev=$("$PARSER" < "$f" 2>&1 >/dev/null || true)
    errs=$(printf '%s\n' "$ev" | grep -c 'EVENT: Error' || true)
    warns=$(printf '%s\n' "$ev" | grep -c 'EVENT: Warning' || true)
    panics=$(printf '%s\n' "$ev" | grep -c 'panicked' || true)
    echo "  parse: errors=$errs warnings=$warns panics=$panics"
    if [ "$errs" -gt 0 ]; then
      printf '%s\n' "$ev" | grep -oE 'code: [A-Za-z]+' | sort | uniq -c | sed 's/^/    /'
    fi
  fi
done

echo
echo "Registry: $REPO_DIR/CONSUMERS.md (update the table if this differs)"
