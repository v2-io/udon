; UDON — "|" element, ":" attribute, ";" comment, "!" dynamic

|element[key].trait :attr value
|element[key].trait :attr value Content on same line
|element[key].trait :attr value |child Child's content
|element
  |child
  Prose with |{em inline elements} and !{{interpolation}}.

|p With |{strong bold}, |{a :href /x link}, and |{em |{strong nested}}.
|p Inline comment: text ;{hidden or emitted} continues.
; Like LaTeX: each |{ needs exactly one } — nesting doesn't double them
|a |b |c                          ; a > b > c
|a :x 1 |b :y 2 |c Text           ; nesting with attrs
|div |{a A} |{b B} |{c C}         ; siblings

|config :num 42 :str "quoted" :word unquoted :flag :nil nil
  :list [a b "c d"] :empty [] :mixed [1 true "x" nil]
  :inline |{x :a 1 content}
  :structured
    |nested :foo bar

|[id-only] |empty |.mixin-only
|.reusable :timeout 30
|service.reusable.another :name x ; multiple mixins
|functional?                      ; == |functional :'?' true
|field?[key]+                     ; suffix before/after key

|license[mit] MIT License...
|project :license @[mit]          ; @[key] refers to element (inert; tools resolve)

!if user
  Welcome, !{{user.name | capitalize}}!
  !if user.admin |admin-panel
  !elif user.mod |mod-panel
  !else |user-panel
!else |login

!for item in items
  |item :id !{{item.id}} !{{item.name}}

!let x = items | first
  |featured !{{x.title}}

!:ruby:
  # not parsed as UDON
!include partials/header

\|escaped \:colon \;semicolon \\backslash

|raw ```
literal |pipes and :colons
``` back to normal
